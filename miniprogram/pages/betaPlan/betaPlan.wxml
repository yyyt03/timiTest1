<view class="container">
  <!-- 顶部筛选选项 -->
  <view class="filter-section">
    <view class="filter-tabs">
      <view class="filter-tab {{currentFilter === 'featured' ? 'active' : ''}}" bindtap="switchFilter" data-type="featured">
        精选方案
      </view>
      <view class="filter-tab {{currentFilter === 'latest' ? 'active' : ''}}" bindtap="switchFilter" data-type="latest">
        最新方案
      </view>
    </view>
  </view>

  <!-- 英雄分类选择器 -->
  <view class="hero-selector" wx:if="{{heroCategories.length > 0}}">
    <view class="selector-header" bindtap="toggleHeroSelector">
      <text class="selector-title">
        {{selectedHero === 'all' ? '全部英雄' : selectedHero}}
      </text>
      <text class="selector-count">({{total}})</text>
      <text class="selector-arrow {{showHeroSelector ? 'expanded' : ''}}">▼</text>
    </view>
    
    <!-- 英雄分类列表 -->
    <view class="hero-list {{showHeroSelector ? 'show' : ''}}" wx:if="{{showHeroSelector}}">
      <!-- 全部选项 -->
      <view class="hero-item {{selectedHero === 'all' ? 'selected' : ''}}" 
            bindtap="selectHero" data-hero="all">
        <text class="hero-name">全部英雄</text>
        <text class="hero-count">({{allBetaPlans.length}})</text>
      </view>
      
      <!-- 英雄选项 -->
      <view class="hero-item {{selectedHero === item.heroName ? 'selected' : ''}}" 
            wx:for="{{heroCategories}}" wx:key="heroName"
            bindtap="selectHero" data-hero="{{item.heroName}}">
        <text class="hero-name">{{item.heroName}}</text>
        <text class="hero-count">({{item.count}})</text>
      </view>
    </view>
  </view>

  <!-- 方案列表 -->
  <view class="plans-section">
    <!-- 加载中 -->
    <view class="loading-container" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <view class="loading-text">加载中...</view>
    </view>
    
    <!-- 方案列表 -->
    <view class="plans-grid" wx:else>
      <view class="plan-card" wx:for="{{betaPlans}}" wx:key="_id" bindtap="viewPlan" data-plan="{{item}}">
        <!-- 方案头部 -->
        <view class="plan-header">
          <image class="plan-hero-avatar" src="{{item.heroAvatar}}" mode="aspectFit"></image>
          <view class="plan-info">
            <view class="plan-title">{{item.title}}</view>
            <view class="plan-hero-name">{{item.heroName}}</view>
          </view>
          <view class="plan-stats">
            <view class="stat-item" catchtap="toggleLike" data-plan="{{item}}" data-index="{{index}}">
              <image class="stat-icon" src="{{item.isLiked ? likeFilledIcon : likeOutlineIcon}}" mode="aspectFit"></image>
              <text class="stat-text">{{item.likeCount}}</text>
            </view>
            <view class="stat-item" catchtap="toggleFavorite" data-plan="{{item}}" data-index="{{index}}">
              <image class="stat-icon" src="{{item.isFavorited ? favoriteFilledIcon : favoriteOutlineIcon}}" mode="aspectFit"></image>
              <text class="stat-text">{{item.favoriteCount}}</text>
            </view>
          </view>
        </view>
        
        <!-- 方案描述 -->
        <view class="plan-description">{{item.description}}</view>
        
        <!-- 方案标签 -->
        <view class="plan-tags">
          <view class="tag beta-tag">体验服</view>
          <view class="tag" wx:if="{{item.difficulty}}">{{item.difficulty}}</view>
          <view class="tag" wx:if="{{item.style}}">{{item.style}}</view>
          <view class="tag" wx:if="{{item.role}}">{{item.role}}</view>
        </view>
        
        <!-- 方案底部 -->
        <view class="plan-footer">
          <view class="plan-author">
            <text class="author-text">作者：{{item.creatorName}}</text>
          </view>
          <view class="plan-time">🕒 {{item.createTime}}</view>
        </view>
      </view>
    </view>
    
    <!-- 无数据提示 -->
    <view class="no-data" wx:if="{{!loading && betaPlans.length === 0}}">
      <image class="no-data-icon" src="{{emptyIcon}}" mode="aspectFit"></image>
      <view class="no-data-text">暂无体验服方案</view>
      <view class="no-data-tip">试试切换筛选条件</view>
    </view>
    
    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{loadingMore}}">
      <view class="loading-spinner"></view>
      <view class="loading-text">加载中...</view>
    </view>
    
    <!-- 没有更多数据 -->
    <view class="no-more" wx:if="{{!hasMore && betaPlans.length > 0}}">
      <view class="no-more-text">没有更多数据了</view>
    </view>
  </view>
</view> 