.container {
  background-color: #f5f7fa;
  min-height: 100vh;
}

/* 顶部筛选选项 */
.filter-section {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 0;
  margin: 0;
  border-radius: 0;
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.3);
  position: sticky;
  top: 0;
  z-index: 100;
  width: 100vw;
  left: 0;
}

.filter-tabs {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 0;
  padding: 16rpx 20rpx 16rpx 20rpx;
  width: 100vw;
  min-height: 80rpx;
  position: relative;
  background: transparent;
  overflow: visible;
}

.filter-tab {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.85);
  padding: 18rpx 0;
  margin: 0 12rpx;
  border-radius: 40rpx;
  position: relative;
  font-weight: 500;
  background: transparent;
  border: none;
  cursor: pointer;
  z-index: 1;
  transition: color 0.25s cubic-bezier(0.4,0,0.2,1);
  overflow: visible;
}

.filter-tab.active {
  color: #f5f7fa;
  font-weight: 700;
  text-shadow: 0 2rpx 8rpx rgba(102,126,234,0.12);
}

.filter-tab::before {
  content: '';
  display: block;
  position: absolute;
  left: 50%;
  top: 50%;
  width: 0;
  height: 0;
  background: rgba(255,255,255,0.22);
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx 0 rgba(255,255,255,0.10), 0 1rpx 8rpx 0 rgba(102,126,234,0.08);
  opacity: 0;
  transform: translate(-50%, -50%) scale(0.7);
  transition:
    width 0.35s cubic-bezier(0.4,0,0.2,1),
    height 0.35s cubic-bezier(0.4,0,0.2,1),
    opacity 0.2s,
    transform 0.35s cubic-bezier(0.4,0,0.2,1);
  z-index: -1;
}

.filter-tab.active::before {
  width: 92%;
  height: 92%;
  opacity: 1;
  transform: translate(-50%, -50%) scale(1.08);
  background: rgba(255,255,255,0.32);
  box-shadow: 0 6rpx 24rpx 0 rgba(255,255,255,0.13), 0 2rpx 12rpx 0 rgba(102,126,234,0.08);
}

.filter-tab:active {
  color: #e0e7ff;
  background: transparent;
  transition: color 0.1s;
}

/* 英雄分类选择器 */
.hero-selector {
  margin: 0 20rpx 20rpx 20rpx;
  background: #ffffff;
  border-radius: 8rpx;
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  border: 1rpx solid #e1e5e9;
  width: calc(100% - 40rpx);
}

.selector-header {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 60rpx;
  padding: 0rpx 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
  cursor: pointer;
  transition: background-color 0.2s ease;
  box-sizing: border-box;
}

.selector-header:active {
  background: #f8f9fa;
}

.selector-title {
  font-size: 24rpx;
  font-weight: 500;
  color: #1a1a1a;
  flex: 1;
  text-align: center;
}

.selector-count {
  font-size: 20rpx;
  color: #666666;
  margin-left: 12rpx;
}

.selector-arrow {
  font-size: 16rpx;
  color: #999999;
  transition: transform 0.2s ease;
  margin-left: 16rpx;
}

.selector-arrow.expanded {
  transform: rotate(180deg);
}

.hero-list {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
  background: #ffffff;
}

.hero-list.show {
  max-height: 600rpx;
  overflow-y: auto;
}

.hero-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: background-color 0.2s ease;
  cursor: pointer;
}

.hero-item:last-child {
  border-bottom: none;
}

.hero-item:active {
  background: #f8f9fa;
}

.hero-item.selected {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
}

.hero-item.selected .hero-name,
.hero-item.selected .hero-count {
  color: #ffffff;
}

.hero-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #1a1a1a;
}

.hero-count {
  font-size: 22rpx;
  color: #666666;
}

/* 方案列表 */
.plans-section {
  padding: 20rpx 30rpx;
}

.plans-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.plan-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  border: 2rpx solid transparent;
}

.plan-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.plan-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.plan-hero-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  border: 2rpx solid #f0f0f0;
}

.plan-info {
  flex: 1;
}

.plan-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
  line-height: 1.3;
}

.plan-hero-name {
  font-size: 24rpx;
  color: #666;
}

.plan-stats {
  display: flex;
  gap: 32rpx;
}

.plan-stats .stat-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #666;
  padding: 12rpx 16rpx;
  border-radius: 20rpx;
  transition: all 0.3s ease;
  background: rgba(102, 126, 234, 0.05);
  border: 2rpx solid rgba(102, 126, 234, 0.1);
}

.plan-stats .stat-item:active {
  background: rgba(102, 126, 234, 0.1);
  transform: scale(0.95);
  border-color: rgba(102, 126, 234, 0.2);
}

.stat-icon {
  width: 52rpx;
  height: 52rpx;
}

.plan-description {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.plan-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 22rpx;
  color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
}

.beta-tag {
  color: #ff6b6b;
  background: rgba(255, 107, 107, 0.1);
  font-weight: 600;
}

.plan-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.plan-author {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}

.author-text {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.plan-time {
  font-size: 22rpx;
  color: #999;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #666;
}

/* 无数据状态 */
.no-data {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.no-data-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
  opacity: 0.6;
}

.no-data-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.no-data-tip {
  font-size: 26rpx;
  color: #999;
}

/* 加载更多 */
.load-more {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.load-more .loading-spinner {
  margin-bottom: 20rpx;
}

.load-more .loading-text {
  font-size: 26rpx;
  color: #666;
}

/* 没有更多数据 */
.no-more {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}

.no-more-text {
  font-size: 26rpx;
  color: #999;
} 