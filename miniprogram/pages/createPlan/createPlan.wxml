<view class="container">
  <view class="title">方案创作</view>
  
  <view class="step-container">
    <view class="step-title">第一步：选择英雄</view>
    <view class="hero-info" wx:if="{{hero}}">
      <view class="hero-name">已选择：{{hero}}</view>
      <button class="hero-select-btn" bindtap="selectFromCategory">重新选择</button>
    </view>
    <button class="hero-select-btn" wx:else bindtap="selectFromCategory">从英雄分类中选择</button>
  </view>
  
  <block wx:if="{{selectedHero}}">
    <view class="step-container">
      <view class="step-title">第二步：选择技能流派和天赋</view>
      
      <!-- 加载状态 -->
      <view class="loading-container" wx:if="{{skillsLoading}}">
        <view class="loading-text">正在加载技能数据...</view>
      </view>
      
      <!-- 技能选择区域 -->
      <block wx:if="{{!skillsLoading && heroSkills}}">
        <!-- 技能一 -->
        <view class="skill-section">
          <view class="skill-title">技能一</view>
          
          <!-- 流派选择 -->
          <view class="core-section">
            <view class="core-title">核心流派（必选1个）</view>
            <view class="core-list">
              <view 
                class="core-item {{selectedCores.skillOne === index ? 'selected' : ''}}" 
                wx:for="{{heroSkills.skillOne.cores}}" 
                wx:key="index"
                bindtap="selectCore" 
                data-skill-type="skillOne" 
                data-index="{{index}}">
                <view class="core-name">{{item.name}}</view>
                <view class="core-desc" wx:if="{{item.description}}">{{item.description}}</view>
                <view class="core-tag">{{item.tag}}</view>
                <!-- 优先按钮（仅选择该核心后显示） -->
                <view wx:if="{{selectedCores.skillOne === index}}"
                  class="priority-btn {{priorityCores.skillOne === index ? 'priority-active' : 'priority-inactive'}}"
                  catchtap="togglePriorityCore"
                  data-skill-type="skillOne"
                  data-index="{{index}}">
                  <text class="priority-text">{{priorityCores.skillOne === index ? '★' : '☆'}}</text>
                </view>
              </view>
            </view>
          </view>
          
          <!-- 天赋选择 -->
          <view class="talent-section" wx:if="{{selectedCores.skillOne !== -1}}">
            <view class="talent-title-container">
              <text class="talent-title">天赋加点</text>
              <text class="talent-subtitle">优先加点-选中星号</text>
            </view>
            <view class="talent-list">
              <view 
                class="talent-item {{talentSelected.skillOne[index] ? 'selected' : ''}}" 
                wx:for="{{heroSkills.skillOne.talents}}" 
                wx:key="index"
                bindtap="toggleTalent" 
                data-skill-type="skillOne" 
                data-index="{{index}}">
                <view class="talent-name">{{item.name}}</view>
                <view class="talent-desc" wx:if="{{item.description}}">{{item.description}}</view>
                <view class="talent-tag">{{item.tag}}</view>
                <!-- 优先按钮（仅天赋被选中后显示） -->
                <view wx:if="{{talentSelected.skillOne[index]}}"
                  class="priority-btn {{priorityTalentsFlags.skillOne[index] ? 'priority-active' : 'priority-inactive'}}"
                  catchtap="togglePriorityTalent"
                  data-skill-type="skillOne"
                  data-index="{{index}}"
                  data-force-update="{{forceUpdate}}">
                  <text class="priority-text">{{priorityTalentsFlags.skillOne[index] ? '★' : '☆'}}</text>
                </view>
              </view>
            </view>
            <view class="talent-count">已选择 {{selectedTalents.skillOne.length}}/3</view>
          </view>
        </view>

        <!-- 技能二 -->
        <view class="skill-section">
          <view class="skill-title">技能二</view>
          
          <!-- 流派选择 -->
          <view class="core-section">
            <view class="core-title">核心流派（必选1个）</view>
            <view class="core-list">
              <view 
                class="core-item {{selectedCores.skillTwo === index ? 'selected' : ''}}" 
                wx:for="{{heroSkills.skillTwo.cores}}" 
                wx:key="index"
                bindtap="selectCore" 
                data-skill-type="skillTwo" 
                data-index="{{index}}">
                <view class="core-name">{{item.name}}</view>
                <view class="core-desc" wx:if="{{item.description}}">{{item.description}}</view>
                <view class="core-tag">{{item.tag}}</view>
                <!-- 优先按钮（仅选择该核心后显示） -->
                <view wx:if="{{selectedCores.skillTwo === index}}"
                  class="priority-btn {{priorityCores.skillTwo === index ? 'priority-active' : 'priority-inactive'}}"
                  catchtap="togglePriorityCore"
                  data-skill-type="skillTwo"
                  data-index="{{index}}">
                  <text class="priority-text">{{priorityCores.skillTwo === index ? '★' : '☆'}}</text>
                </view>
              </view>
            </view>
          </view>
          
          <!-- 天赋选择 -->
          <view class="talent-section" wx:if="{{selectedCores.skillTwo !== -1}}">
            <view class="talent-title-container">
              <text class="talent-title">天赋加点</text>
              <text class="talent-subtitle">优先加点-选中星号</text>
            </view>
            <view class="talent-list">
              <view 
                class="talent-item {{talentSelected.skillTwo[index] ? 'selected' : ''}}" 
                wx:for="{{heroSkills.skillTwo.talents}}" 
                wx:key="index"
                bindtap="toggleTalent" 
                data-skill-type="skillTwo" 
                data-index="{{index}}">
                <view class="talent-name">{{item.name}}</view>
                <view class="talent-desc" wx:if="{{item.description}}">{{item.description}}</view>
                <view class="talent-tag">{{item.tag}}</view>
                <!-- 优先按钮（仅天赋被选中后显示） -->
                <view wx:if="{{talentSelected.skillTwo[index]}}"
                  class="priority-btn {{priorityTalentsFlags.skillTwo[index] ? 'priority-active' : 'priority-inactive'}}"
                  catchtap="togglePriorityTalent"
                  data-skill-type="skillTwo"
                  data-index="{{index}}"
                  data-force-update="{{forceUpdate}}">
                  <text class="priority-text">{{priorityTalentsFlags.skillTwo[index] ? '★' : '☆'}}</text>
                </view>
              </view>
            </view>
            <view class="talent-count">已选择 {{selectedTalents.skillTwo.length}}/3</view>
          </view>
        </view>

        <!-- 技能三 -->
        <view class="skill-section">
          <view class="skill-title">技能三</view>
          
          <!-- 流派选择 -->
          <view class="core-section">
            <view class="core-title">核心流派（必选1个）</view>
            <view class="core-list">
              <view 
                class="core-item {{selectedCores.skillThree === index ? 'selected' : ''}}" 
                wx:for="{{heroSkills.skillThree.cores}}" 
                wx:key="index"
                bindtap="selectCore" 
                data-skill-type="skillThree" 
                data-index="{{index}}">
                <view class="core-name">{{item.name}}</view>
                <view class="core-desc" wx:if="{{item.description}}">{{item.description}}</view>
                <view class="core-tag">{{item.tag}}</view>
                <!-- 优先按钮（仅选择该核心后显示） -->
                <view wx:if="{{selectedCores.skillThree === index}}"
                  class="priority-btn {{priorityCores.skillThree === index ? 'priority-active' : 'priority-inactive'}}"
                  catchtap="togglePriorityCore"
                  data-skill-type="skillThree"
                  data-index="{{index}}">
                  <text class="priority-text">{{priorityCores.skillThree === index ? '★' : '☆'}}</text>
                </view>
              </view>
            </view>
          </view>
          
          <!-- 天赋选择 -->
          <view class="talent-section" wx:if="{{selectedCores.skillThree !== -1}}">
            <view class="talent-title-container">
              <text class="talent-title">天赋加点</text>
              <text class="talent-subtitle">优先加点-选中星号</text>
            </view>
            <view class="talent-list">
              <view 
                class="talent-item {{talentSelected.skillThree[index] ? 'selected' : ''}}" 
                wx:for="{{heroSkills.skillThree.talents}}" 
                wx:key="index"
                bindtap="toggleTalent" 
                data-skill-type="skillThree" 
                data-index="{{index}}">
                <view class="talent-name">{{item.name}}</view>
                <view class="talent-desc" wx:if="{{item.description}}">{{item.description}}</view>
                <view class="talent-tag">{{item.tag}}</view>
                <!-- 优先按钮（仅天赋被选中后显示） -->
                <view wx:if="{{talentSelected.skillThree[index]}}"
                  class="priority-btn {{priorityTalentsFlags.skillThree[index] ? 'priority-active' : 'priority-inactive'}}"
                  catchtap="togglePriorityTalent"
                  data-skill-type="skillThree"
                  data-index="{{index}}"
                  data-force-update="{{forceUpdate}}">
                  <text class="priority-text">{{priorityTalentsFlags.skillThree[index] ? '★' : '☆'}}</text>
                </view>
              </view>
            </view>
            <view class="talent-count">已选择 {{selectedTalents.skillThree.length}}/3</view>
          </view>
        </view>
      </block>
    </view>
  </block>
  
          <block wx:if="{{selectedHero}}">
          <view class="step-container">
            <view class="step-title-container">
              <text class="step-title">第三步：出装推荐（6件装备）</text>
              <view class="hint-button" bindtap="showEquipmentHint">
                <text class="hint-icon">?</text>
              </view>
            </view>
            
            <!-- 忽略出装选项 -->
            <view class="skip-equipment-container">
              <view class="skip-equipment-option {{skipEquipment ? 'selected' : ''}}" bindtap="toggleSkipEquipment">
                <view class="skip-equipment-icon">{{skipEquipment ? '✅' : '⭕'}}</view>
                <view class="skip-equipment-text">忽略出装</view>
              </view>
              <view class="skip-equipment-desc">选择此项将跳过出装推荐环节</view>
            </view>
            
            <!-- 装备输入区域 -->
            <view class="equipment-input-container" wx:if="{{!skipEquipment}}">
              <view class="equipment-grid">
                <view class="equipment-item" wx:for="{{equipmentList}}" wx:key="index">
                  <view class="equipment-input-row">
                    <view class="equipment-icon-container">
                      <image 
                        class="equipment-icon" 
                        src="{{item.imageUrl || '../images/unused/default-avatar.png'}}" 
                        mode="aspectFit">
                      </image>
                      <view class="equipment-index">{{index + 1}}</view>
                    </view>
                    <view class="equipment-input-wrapper">
                      <input 
                        class="equipment-input" 
                        placeholder="输入装备名称..." 
                        value="{{item.name}}" 
                        bindinput="onEquipmentInput" 
                        bindblur="onEquipmentBlur"
                        data-index="{{index}}"
                        maxlength="10">
                      </input>
                      <view class="equipment-match-status" wx:if="{{item.name && item.name.length >= 2}}">
                        <text class="match-status {{item.matched ? 'matched' : 'unmatched'}}">
                          {{item.matched ? '✓' : '?'}}
                        </text>
                      </view>

                    </view>
                  </view>
                  <view class="equipment-suggestions" wx:if="{{item.suggestions && item.suggestions.length > 0}}">
                    <view 
                      class="suggestion-item" 
                      wx:for="{{item.suggestions}}" 
                      wx:for-item="suggestion" 
                      wx:key="suggestion.name"
                      bindtap="selectEquipmentSuggestion" 
                      data-main-index="{{index}}"
                      data-suggestion-name="{{suggestion.name}}">
                      <image class="suggestion-icon" src="{{suggestion.imageUrl || '../images/unused/default-avatar.png'}}" mode="aspectFit"></image>
                      <text class="suggestion-name">{{suggestion.name}}</text>
                    </view>
                  </view>
                </view>
              </view>
            </view>
      
      </view>
  </block>
  
  <block wx:if="{{selectedHero}}">
    <view class="step-container">
      <view class="step-title">第四步：方案思路描述</view>
      <textarea class="plan-desc-input" placeholder="推荐3个必点核心? 强势期是前期还是后期? 如何快速发育? 具体玩法?" value="{{planDescription}}" bindinput="onDescriptionInput"></textarea>
    </view>
  </block>

  <block wx:if="{{selectedHero}}">
    <view class="step-container">
      <view class="step-title">第五步：方案名称</view>
      <input class="plan-title-input" placeholder="请输入方案名称，如：爆发流妲己、坦克流亚瑟等" value="{{planTitle}}" bindinput="onTitleInput"></input>
    </view>
  </block>

  <block wx:if="{{selectedHero}}">
    <view class="step-container">
      <view class="step-title">第六步：体验服选项</view>
      <view class="beta-option-container">
        <view class="beta-option-row">
          <view class="beta-option-item {{isBetaPlan ? 'selected' : ''}}" bindtap="selectBetaOption" data-value="true">
            <view class="beta-option-icon">{{isBetaPlan ? '✅' : '⭕'}}</view>
            <view class="beta-option-text">是</view>
          </view>
          <view class="beta-option-item {{!isBetaPlan ? 'selected' : ''}}" bindtap="selectBetaOption" data-value="false">
            <view class="beta-option-icon">{{!isBetaPlan ? '✅' : '⭕'}}</view>
            <view class="beta-option-text">否</view>
          </view>
        </view>
        <view class="beta-option-desc">体验服方案将显示在体验服方案页面中</view>
      </view>
    </view>
  </block>

  <block wx:if="{{selectedHero}}">
    <view class="step-container">
      <view class="step-title">第七步：作者信息</view>
      <input class="author-input" placeholder="请输入您的昵称或游戏ID" value="{{authorName}}" bindinput="onAuthorInput"></input>
    </view>
  </block>
  
  <block wx:if="{{selectedHero}}">
    <view class="btn-container">
      <button class="generate-btn" bindtap="generatePlan">创建方案</button>
    </view>
  </block>
  
  <!-- 敏感词检测加载界面 -->
  <view class="sensitive-check-overlay" wx:if="{{sensitiveCheckLoading}}">
    <view class="sensitive-check-modal">
      <view class="check-header">
        <view class="check-icon">🔒</view>
        <view class="check-title">内容安全检查</view>
        <view class="check-subtitle">正在检测内容安全性，请稍候...</view>
      </view>
      
      <view class="check-progress-container">
        <view class="progress-bar">
          <view class="progress-fill {{progressWidthClass}}"></view>
        </view>
        <view class="progress-text">{{sensitiveCheckProgress}}%</view>
      </view>
      
      <view class="check-step-container">
        <view class="step-indicator">
          <view class="step-dot {{sensitiveCheckProgress >= 20 ? 'active' : ''}}"></view>
          <view class="step-dot {{sensitiveCheckProgress >= 40 ? 'active' : ''}}"></view>
          <view class="step-dot {{sensitiveCheckProgress >= 60 ? 'active' : ''}}"></view>
          <view class="step-dot {{sensitiveCheckProgress >= 80 ? 'active' : ''}}"></view>
          <view class="step-dot {{sensitiveCheckProgress >= 100 ? 'active' : ''}}"></view>
        </view>
        <view class="current-step">{{sensitiveCheckStep}}</view>
        <view class="step-status">{{sensitiveCheckStatus}}</view>
      </view>
      
      <view class="check-animation">
        <view class="scan-line"></view>
      </view>
    </view>
  </view>
</view> 