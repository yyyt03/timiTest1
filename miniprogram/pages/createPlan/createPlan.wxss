.container {
  padding: 30rpx;
  box-sizing: border-box;
  background-color: #ffffff;
  min-height: 100vh;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 40rpx;
  text-align: center;
}

.step-container {
  width: 100%;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid #f0f0f0;
}

.step-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #000000;
}

/* 英雄选择器 */
.hero-selector {
  width: 100%;
}

.picker {
  width: 100%;
  height: 80rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 2rpx solid #e9ecef;
}

.picker-text {
  font-size: 28rpx;
  color: #333333;
}

.picker-arrow {
  font-size: 24rpx;
  color: #999999;
}

/* 流派核心 */
.core-list {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.core-item {
  width: 30%;
  height: 100rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 10rpx;
  box-sizing: border-box;
  border: 2rpx solid #e9ecef;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.core-item.selected {
  background-color: #000000;
  border: 4rpx solid #333333;
  box-shadow: 0 0 15rpx rgba(0, 0, 0, 0.3), 0 0 30rpx rgba(0, 0, 0, 0.2);
  animation: coreGlow 2s ease-in-out infinite alternate;
}

@keyframes coreGlow {
  0% {
    box-shadow: 0 0 15rpx rgba(0, 0, 0, 0.3), 0 0 30rpx rgba(0, 0, 0, 0.2);
  }
  100% {
    box-shadow: 0 0 20rpx rgba(0, 0, 0, 0.4), 0 0 40rpx rgba(0, 0, 0, 0.3);
  }
}

.core-item.selected .core-name {
  color: #ffffff;
  font-weight: bold;
}

.core-name {
  font-size: 26rpx;
  color: #333333;
  text-align: center;
}

/* 特性天赋 */
.talent-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.talent-item {
  width: 23%;
  height: 80rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 15rpx;
  box-sizing: border-box;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
  border: 2rpx solid #e9ecef;
}

.talent-item::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: transparent;
  z-index: 1;
}

.talent-item.selected {
  background-color: #000000;
  border: 4rpx solid #333333;
  box-shadow: 0 0 15rpx rgba(0, 0, 0, 0.3);
}

.talent-name {
  font-size: 24rpx;
  color: #333333;
  text-align: center;
  transition: all 0.3s ease;
  z-index: 2;
  position: relative;
}

.talent-item.selected .talent-name {
  color: #ffffff;
  font-weight: bold;
}

.talent-count {
  font-size: 24rpx;
  color: #666666;
  text-align: right;
}

/* 出装推荐 */
.equipment-input {
  width: 100%;
  height: 200rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  border: 2rpx solid #e9ecef;
  color: #333333;
}

.equipment-code-title {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.equipment-code-input {
  width: 100%;
  height: 80rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  border: 2rpx solid #e9ecef;
  color: #333333;
}

/* 方案思路描述 */
.plan-desc-input {
  width: 100%;
  height: 300rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  border: 2rpx solid #e9ecef;
  color: #333333;
}

/* 生成按钮 */
.btn-container {
  width: 100%;
  margin-top: 40rpx;
  margin-bottom: 60rpx;
}

.generate-btn {
  width: 100%;
  height: 90rpx;
  background-color: #000000;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 45rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.generate-btn:active {
  background-color: #333333;
  transform: translateY(2rpx);
}

.hero-select-btn {
  width: 100%;
  height: 80rpx;
  background-color: #000000;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  border-radius: 8rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 20rpx 0;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.hero-select-btn:active {
  background-color: #333333;
  transform: translateY(2rpx);
}

.hero-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.hero-name {
  font-size: 30rpx;
  color: #333333;
  font-weight: 600;
} 