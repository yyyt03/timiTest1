.container {
  padding: 20rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  min-height: 100vh;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 30rpx;
  text-align: center;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

/* 环境提示 */
.env-notice {
  width: 100%;
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
  border-radius: 12rpx;
  padding: 15rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.3);
  border: 2rpx solid #ff5252;
}

.env-notice.dev {
  background: linear-gradient(135deg, #4ecdc4 0%, #44a08d 100%);
  box-shadow: 0 4rpx 16rpx rgba(78, 205, 196, 0.3);
  border: 2rpx solid #26a69a;
}

.env-text {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 600;
  text-align: center;
  display: block;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
}

.step-container {
  width: 100%;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.step-title-container {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 15rpx;
  gap: 10rpx;
}

.step-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2c3e50;
  padding-bottom: 10rpx;
  border-bottom: 3rpx solid #667eea;
}

.hint-button {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
  flex-shrink: 0;
}

.hint-icon {
  color: white;
  font-size: 28rpx;
  font-weight: bold;
}

/* 忽略出装选项样式 */
.skip-equipment-container {
  margin-bottom: 20rpx;
  padding: 15rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-radius: 12rpx;
  border: 2rpx solid #dee2e6;
}

.skip-equipment-option {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx;
  border-radius: 8rpx;
  cursor: pointer;
  transition: all 0.2s;
  margin-bottom: 8rpx;
}

.skip-equipment-option:hover {
  background: rgba(102, 126, 234, 0.1);
}

.skip-equipment-option.selected {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.skip-equipment-icon {
  font-size: 24rpx;
  width: 32rpx;
  text-align: center;
}

.skip-equipment-text {
  font-size: 26rpx;
  font-weight: 600;
}

.skip-equipment-desc {
  font-size: 22rpx;
  color: #6c757d;
  padding-left: 44rpx;
  line-height: 1.4;
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: #666666;
}

/* 敏感词检测加载界面样式 */
.sensitive-check-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999;
  backdrop-filter: blur(10rpx);
}

.sensitive-check-modal {
  width: 80%;
  max-width: 600rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  animation: modalSlideIn 0.3s ease-out;
}

@keyframes modalSlideIn {
  from {
    opacity: 0;
    transform: translateY(50rpx) scale(0.9);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.check-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.check-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  animation: iconPulse 2s ease-in-out infinite;
}

@keyframes iconPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

.check-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 10rpx;
}

.check-subtitle {
  font-size: 26rpx;
  color: #7f8c8d;
}

.check-progress-container {
  margin-bottom: 40rpx;
}

.progress-bar {
  width: 100%;
  height: 16rpx;
  background: linear-gradient(90deg, #ecf0f1 0%, #bdc3c7 100%);
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #3498db 0%, #2980b9 100%);
  border-radius: 8rpx;
  transition: width 0.3s ease-out;
  position: relative;
  overflow: hidden;
}

.progress-fill::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
  animation: progressShine 1.5s ease-in-out infinite;
}

@keyframes progressShine {
  0% { left: -100%; }
  100% { left: 100%; }
}

/* 进度条宽度类 */
.progress-width-0 { width: 0%; }
.progress-width-10 { width: 10%; }
.progress-width-20 { width: 20%; }
.progress-width-30 { width: 30%; }
.progress-width-40 { width: 40%; }
.progress-width-50 { width: 50%; }
.progress-width-60 { width: 60%; }
.progress-width-70 { width: 70%; }
.progress-width-80 { width: 80%; }
.progress-width-90 { width: 90%; }
.progress-width-100 { width: 100%; }

.progress-text {
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #3498db;
}

.check-step-container {
  text-align: center;
  margin-bottom: 40rpx;
}

.step-indicator {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.step-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #ecf0f1;
  border: 3rpx solid #bdc3c7;
  transition: all 0.3s ease-out;
}

.step-dot.active {
  background: #3498db;
  border-color: #2980b9;
  transform: scale(1.2);
  box-shadow: 0 0 20rpx rgba(52, 152, 219, 0.5);
}

.current-step {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 10rpx;
}

.step-status {
  font-size: 24rpx;
  color: #7f8c8d;
}

.check-animation {
  position: relative;
  height: 60rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #ecf0f1 0%, #bdc3c7 100%);
}

.scan-line {
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(52, 152, 219, 0.6), transparent);
  animation: scanMove 2s ease-in-out infinite;
}

@keyframes scanMove {
  0% { left: -100%; }
  100% { left: 100%; }
}

/* 敏感词检查状态样式 */
.sensitive-check-status {
  margin-top: 4rpx;
  padding: 4rpx 8rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  display: inline-block;
}

.status-text {
  font-size: 22rpx;
  font-weight: 400;
}

.status-text.pass {
  color: #27ae60;
}

.status-text.fail {
  color: #e74c3c;
}

/* 体验服选项样式 */
.beta-option-container {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.beta-option-row {
  display: flex;
  gap: 20rpx;
}

.beta-option-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border: 2rpx solid #dee2e6;
  transition: all 0.3s ease;
  cursor: pointer;
}

.beta-option-item.selected {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-color: #5a6fd8;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
}

.beta-option-item:active {
  transform: scale(0.98);
}

.beta-option-icon {
  font-size: 32rpx;
  width: 40rpx;
  text-align: center;
}

.beta-option-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.beta-option-item.selected .beta-option-text {
  color: #ffffff;
}

.beta-option-desc {
  font-size: 24rpx;
  color: #666666;
  padding: 0 20rpx;
  line-height: 1.4;
}
/* 技能区域 */
.skill-section {
  margin-bottom: 25rpx;
  padding: 15rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-radius: 12rpx;
  border: 1rpx solid #e9ecef;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.skill-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 15rpx;
  text-align: center;
  background: #ffffff;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  display: inline-block;
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid #667eea;
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.2);
}

/* 流派选择 */
.core-section {
  margin-bottom: 20rpx;
}

.core-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 12rpx;
  padding-left: 8rpx;
  border-left: 3rpx solid #667eea;
}

.core-list {
  display: flex;
  flex-direction: row;
  gap: 10rpx;
}

.core-item {
  background: #ffffff;
  border-radius: 10rpx;
  padding: 12rpx;
  box-sizing: border-box;
  border: 2rpx solid #e9ecef;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  flex: 1;
  min-height: 60rpx;
}

.core-item.selected {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border: 3rpx solid #5a6fd8;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
  transform: translateY(-2rpx);
}

.core-item.selected .core-name,
.core-item.selected .core-tag {
  color: #ffffff;
}

.core-name {
  font-size: 24rpx;
  color: #2c3e50;
  font-weight: 600;
  width: 100%;
  margin-bottom: 4rpx;
}

.core-desc {
  font-size: 18rpx;
  color: #666666;
  line-height: 1.3;
  width: 100%;
  margin-bottom: 6rpx;
  overflow: visible;
  white-space: normal;
  word-wrap: break-word;
  word-break: break-all;
}

.core-item.selected .core-desc {
  color: rgba(255, 255, 255, 0.8);
}

.core-tag {
  font-size: 18rpx;
  color: #666666;
  background-color: #f0f0f0;
  padding: 3rpx 6rpx;
  border-radius: 6rpx;
  display: inline-block;
  font-weight: 500;
  align-self: flex-end;
  margin-top: auto;
  margin-right: 0; /* 完全贴合右下角 */
}

.core-item.selected .core-tag {
  background-color: rgba(255, 255, 255, 0.2);
  color: #ffffff;
}

/* 天赋选择 */
.talent-section {
  margin-top: 15rpx;
}

.talent-title-container {
  display: flex;
  align-items: center;
  gap: 15rpx;
  margin-bottom: 12rpx;
}

.talent-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #2c3e50;
  padding-left: 8rpx;
  border-left: 3rpx solid #7db7f6;
}

.talent-subtitle {
  font-size: 20rpx;
  font-weight: 500;
  color: #333333;
  background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid #7db7f6;
}

.talent-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.talent-item {
  background: #ffffff;
  border-radius: 8rpx;
  padding: 8rpx;
  box-sizing: border-box;
  transition: all 0.2s;
  position: relative;
  overflow: hidden;
  border: 2rpx solid #d0e6fa;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-height: 60rpx;
  box-shadow: 0 2rpx 8rpx rgba(125, 183, 246, 0.08);
}

.talent-item.selected {
  background: linear-gradient(135deg, #b3d8fd 0%, #e3f1fd 100%);
  border: 3rpx solid #7db7f6;
  box-shadow: 0 4rpx 16rpx rgba(125, 183, 246, 0.18);
  transform: translateY(-2rpx);
}

.talent-item.selected .talent-name,
.talent-item.selected .talent-tag {
  color: #2176c1;
}

.talent-name {
  font-size: 20rpx;
  color: #2c3e50;
  font-weight: 600;
  line-height: 1.2;
  width: 100%;
  margin-bottom: 3rpx;
}

.talent-desc {
  font-size: 16rpx;
  color: #666666;
  line-height: 1.2;
  width: 100%;
  margin-bottom: 4rpx;
  overflow: visible;
  white-space: normal;
  word-wrap: break-word;
  word-break: break-all;
}

.talent-item.selected .talent-desc {
  color: rgba(33, 118, 193, 0.8);
}

.talent-tag {
  font-size: 16rpx;
  color: #5a7fa6;
  background-color: #eaf4fb;
  padding: 2rpx 6rpx;
  border-radius: 6rpx;
  display: inline-block;
  font-weight: 500;
  align-self: flex-end;
  margin-top: auto;
  margin-right: 0; /* 完全贴合右下角 */
}

.talent-item.selected .talent-tag {
  background-color: rgba(125, 183, 246, 0.18);
  color: #2176c1;
}

.talent-count {
  font-size: 22rpx;
  color: #7db7f6;
  text-align: right;
  font-weight: 500;
}

/* 优先按钮样式 */
.priority-btn {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 6rpx;
  width: 48rpx;
  height: 36rpx;
  box-shadow: 0 2rpx 6rpx rgba(102, 126, 234, 0.3);
  border: 1rpx solid #5a6fd8;
  cursor: pointer;
  transition: all 0.3s ease;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
}

.priority-btn.priority-active {
  background: linear-gradient(135deg, #4ecdc4 0%, #44a08d 100%);
  box-shadow: 0 2rpx 6rpx rgba(78, 205, 196, 0.4);
  border: 1rpx solid #26a69a;
  transform: scale(1.1);
}

/* 未激活（已选中但未设为优先）的灰色状态 */
.priority-btn.priority-inactive {
  background: linear-gradient(135deg, #cccccc 0%, #999999 100%);
  border: 1rpx solid #999999;
  opacity: 0.9;
}

/* 未选中时完全隐藏按钮 */
.priority-hidden {
  display: none;
}

.priority-text {
  font-size: 20rpx;
  color: #ffffff;
  font-weight: 600;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
  line-height: 1;
}

.priority-btn.priority-active {
  background: linear-gradient(135deg, #4ecdc4 0%, #44a08d 100%);
  box-shadow: 0 2rpx 6rpx rgba(78, 205, 196, 0.4);
  border: 1rpx solid #26a69a;
  transform: scale(1.1);
}

.priority-btn.priority-active .priority-text {
  color: #ffffff;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
}

.priority-btn.priority-disabled {
  background: linear-gradient(135deg, #cccccc 0%, #999999 100%);
  border: 1rpx solid #999999;
  opacity: 0.6;
  cursor: not-allowed;
}

.priority-btn.priority-disabled .priority-text {
  color: #666666;
}

/* 核心项和天赋项的优先按钮位置调整 */
.core-item .priority-btn {
  top: 6rpx;
  right: 6rpx;
}

.talent-item .priority-btn {
  top: 6rpx;
  right: 6rpx;
}

/* 英雄选择器 */
.hero-selector {
  width: 100%;
}

.picker {
  width: 100%;
  height: 80rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 2rpx solid #e9ecef;
}

.picker-text {
  font-size: 28rpx;
  color: #333333;
}

.picker-arrow {
  font-size: 24rpx;
  color: #999999;
}

/* 装备输入区域 */
.equipment-input-container {
  margin-bottom: 20rpx;
}

.equipment-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: repeat(3, 1fr);
  gap: 12rpx;
}

.equipment-item {
  background: #ffffff;
  border-radius: 8rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid #e9ecef;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.equipment-input-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  width: 100%;
}

.equipment-icon-container {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.equipment-icon {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 2rpx solid #e9ecef;
  background: #f8f9fa;
}

.equipment-index {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 20rpx;
  height: 20rpx;
  background: #667eea;
  color: #ffffff;
  border-radius: 50%;
  font-size: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}

.equipment-input-wrapper {
  width: 100%;
  position: relative;
}

.equipment-input {
  width: 100%;
  height: 32rpx;
  border: 1rpx solid #e9ecef;
  border-radius: 4rpx;
  padding: 0 28rpx 0 8rpx;
  font-size: 16rpx;
  color: #2c3e50;
  background: #ffffff;
  box-sizing: border-box;
  transition: all 0.3s ease;
  text-align: center;
}

.equipment-input:focus {
  border-color: #667eea;
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.2);
}

.equipment-match-status {
  position: absolute;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
}

.match-status {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14rpx;
  font-weight: 600;
}

.match-status.matched {
  background: #28a745;
  color: #ffffff;
}

.match-status.unmatched {
  background: #ffc107;
  color:rgb(0, 0, 0);
}



/* 装备建议 */
.equipment-suggestions {
  margin-top: 8rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid #e9ecef;
}

.suggestion-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 10rpx;
  background: #f8f9fa;
  border: 1rpx solid #e9ecef;
  border-radius: 6rpx;
  margin-bottom: 4rpx;
  transition: background-color 0.2s ease;
}

.suggestion-item:active {
  background: #dee2e6;
  border-color: #adb5bd;
}

.suggestion-item:active .suggestion-icon {
  border-color: #adb5bd;
}

.suggestion-item:active .suggestion-name {
  color: #495057;
}

.suggestion-icon {
  width: 24rpx;
  height: 24rpx;
  border-radius: 4rpx;
  border: 1rpx solid #e9ecef;
}

.suggestion-name {
  font-size: 20rpx;
  color: #2c3e50;
  font-weight: 500;
}

/* 兼容性样式 - 已移除旧的装备输入样式 */

.equipment-code-title {
  font-size: 26rpx;
  color: #333333;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.equipment-code-input {
  width: 100%;
