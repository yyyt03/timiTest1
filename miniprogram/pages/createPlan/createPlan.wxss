/* 生成按钮 */
.btn-container {
  width: 100%;
  margin-top: 30rpx;
  margin-bottom: 50rpx;
}

.generate-btn {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: all 0.3s ease;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.3);
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.generate-btn:active {
  background: linear-gradient(135deg, #5a6fd8 0%, #6a4190 100%);
  transform: translateY(2rpx);
}

.hero-select-btn {
  width: 100%;
  height: 70rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  border-radius: 8rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 15rpx 0;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
}

.hero-select-btn:active {
  background: linear-gradient(135deg, #5a6fd8 0%, #6a4190 100%);
  transform: translateY(2rpx);
}

.hero-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.hero-name {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 600;
} 