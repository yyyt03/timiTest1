.container {
  padding: 30rpx;
  box-sizing: border-box;
  background-color: #1a1a2e;
  min-height: 100vh;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 40rpx;
  text-align: center;
}

.step-container {
  width: 100%;
  background-color: #2c2c54;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.step-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #e0e0e0;
  margin-bottom: 20rpx;
  padding-bottom: 10rpx;
  border-bottom: 2rpx solid #4a00e0;
}

/* 英雄选择器 */
.hero-selector {
  width: 100%;
}

.picker {
  width: 100%;
  height: 80rpx;
  background-color: #1a1a2e;
  border-radius: 8rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 2rpx solid #4a00e0;
}

.picker-text {
  font-size: 28rpx;
  color: #e0e0e0;
}

.picker-arrow {
  font-size: 24rpx;
  color: #999999;
}

/* 流派核心 */
.core-list {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.core-item {
  width: 30%;
  height: 100rpx;
  background-color: #1a1a2e;
  border-radius: 8rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 10rpx;
  box-sizing: border-box;
  border: 2rpx solid #4a00e0;
}

.core-item.selected {
  background-color: #4A90E2;
}

.core-item.selected .core-name {
  color: #ffffff;
}

.core-name {
  font-size: 26rpx;
  color: #e0e0e0;
  text-align: center;
}

/* 特性天赋 */
.talent-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.talent-item {
  width: 23%;
  height: 80rpx;
  background-color: #1a1a2e;
  border-radius: 8rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 15rpx;
  box-sizing: border-box;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
  border: 2rpx solid #4a00e0;
}

.talent-item::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: transparent;
  z-index: 1;
}

.talent-item.selected {
  background-color: #4A90E2;
  border: 4rpx solid #2a70c2;
  box-shadow: 0 0 15rpx rgba(74, 144, 226, 0.6);
}

.talent-name {
  font-size: 24rpx;
  color: #e0e0e0;
  text-align: center;
  transition: all 0.3s ease;
  z-index: 2;
  position: relative;
}

.talent-item.selected .talent-name {
  color: #ffffff;
  font-weight: bold;
}

.talent-count {
  font-size: 24rpx;
  color: #999999;
  text-align: right;
}

/* 出装推荐 */
.equipment-input {
  width: 100%;
  height: 200rpx;
  background-color: #1a1a2e;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  border: 2rpx solid #4a00e0;
  color: #e0e0e0;
}

.equipment-code-title {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 10rpx;
}

.equipment-code-input {
  width: 100%;
  height: 80rpx;
  background-color: #1a1a2e;
  border-radius: 8rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  border: 2rpx solid #4a00e0;
  color: #e0e0e0;
}

/* 方案思路描述 */
.plan-desc-input {
  width: 100%;
  height: 300rpx;
  background-color: #1a1a2e;
  border-radius: 8rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  border: 2rpx solid #4a00e0;
  color: #e0e0e0;
}

/* 生成按钮 */
.btn-container {
  width: 100%;
  margin-top: 40rpx;
  margin-bottom: 60rpx;
}

.generate-btn {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(to right, #8e2de2, #4a00e0);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 45rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.hero-category-tip {
  margin: 20rpx 0;
  padding: 15rpx 0;
  text-align: center;
}

.hero-category-tip text {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: bold;
  text-decoration: underline;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
  letter-spacing: 2rpx;
}

.hero-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.hero-name {
  font-size: 30rpx;
  color: #e0e0e0;
  font-weight: bold;
} 