.container {
  padding: 20rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  min-height: 100vh;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 30rpx;
  text-align: center;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.step-container {
  width: 100%;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.step-title-container {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 15rpx;
  gap: 10rpx;
}

.step-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2c3e50;
  padding-bottom: 10rpx;
  border-bottom: 3rpx solid #667eea;
}

.hint-button {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
  flex-shrink: 0;
}

.hint-icon {
  color: white;
  font-size: 28rpx;
  font-weight: bold;
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: #666666;
}

/* 技能区域 */
.skill-section {
  margin-bottom: 25rpx;
  padding: 15rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-radius: 12rpx;
  border: 1rpx solid #e9ecef;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.skill-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 15rpx;
  text-align: center;
  background: #ffffff;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  display: inline-block;
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid #667eea;
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.2);
}

/* 流派选择 */
.core-section {
  margin-bottom: 20rpx;
}

.core-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 12rpx;
  padding-left: 8rpx;
  border-left: 3rpx solid #667eea;
}

.core-list {
  display: flex;
  flex-direction: row;
  gap: 10rpx;
}

.core-item {
  background: #ffffff;
  border-radius: 10rpx;
  padding: 12rpx;
  box-sizing: border-box;
  border: 2rpx solid #e9ecef;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  flex: 1;
  min-height: 60rpx;
}

.core-item.selected {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border: 3rpx solid #5a6fd8;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
  transform: translateY(-2rpx);
}

.core-item.selected .core-name,
.core-item.selected .core-tag {
  color: #ffffff;
}

.core-name {
  font-size: 24rpx;
  color: #2c3e50;
  font-weight: 600;
  flex: 1;
}

.core-tag {
  font-size: 18rpx;
  color: #666666;
  background-color: #f0f0f0;
  padding: 3rpx 6rpx;
  border-radius: 6rpx;
  display: inline-block;
  font-weight: 500;
}

.core-item.selected .core-tag {
  background-color: rgba(255, 255, 255, 0.2);
  color: #ffffff;
}

/* 天赋选择 */
.talent-section {
  margin-top: 15rpx;
}

.talent-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 12rpx;
  padding-left: 8rpx;
  border-left: 3rpx solid #ff6b35;
}

.talent-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.talent-item {
  background: #ffffff;
  border-radius: 6rpx;
  padding: 8rpx;
  box-sizing: border-box;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
  border: 2rpx solid #e9ecef;
  cursor: pointer;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 60rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.talent-item.selected {
  background: linear-gradient(135deg, #ff6b35 0%, #f7931e 100%);
  border: 3rpx solid #e55a2b;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.3);
  transform: translateY(-2rpx);
}

.talent-item.selected .talent-name,
.talent-item.selected .talent-tag {
  color: #ffffff;
}

.talent-name {
  font-size: 20rpx;
  color: #2c3e50;
  font-weight: 600;
  line-height: 1.2;
  flex: 1;
}

.talent-tag {
  font-size: 16rpx;
  color: #666666;
  background-color: #f0f0f0;
  padding: 2rpx 4rpx;
  border-radius: 4rpx;
  display: inline-block;
  font-weight: 500;
}

.talent-item.selected .talent-tag {
  background-color: rgba(255, 255, 255, 0.2);
  color: #ffffff;
}

.talent-count {
  font-size: 22rpx;
  color: #666666;
  text-align: right;
  font-weight: 500;
}

/* 英雄选择器 */
.hero-selector {
  width: 100%;
}

.picker {
  width: 100%;
  height: 80rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 2rpx solid #e9ecef;
}

.picker-text {
  font-size: 28rpx;
  color: #333333;
}

.picker-arrow {
  font-size: 24rpx;
  color: #999999;
}

/* 装备输入区域 */
.equipment-input-container {
  margin-bottom: 20rpx;
}

.equipment-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: repeat(3, 1fr);
  gap: 12rpx;
}

.equipment-item {
  background: #ffffff;
  border-radius: 8rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid #e9ecef;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.equipment-input-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  width: 100%;
}

.equipment-icon-container {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.equipment-icon {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 2rpx solid #e9ecef;
  background: #f8f9fa;
}

.equipment-index {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 20rpx;
  height: 20rpx;
  background: #667eea;
  color: #ffffff;
  border-radius: 50%;
  font-size: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}

.equipment-input-wrapper {
  width: 100%;
  position: relative;
}

.equipment-input {
  width: 100%;
  height: 32rpx;
  border: 1rpx solid #e9ecef;
  border-radius: 4rpx;
  padding: 0 8rpx;
  font-size: 16rpx;
  color: #2c3e50;
  background: #ffffff;
  box-sizing: border-box;
  transition: all 0.3s ease;
  text-align: center;
}

.equipment-input:focus {
  border-color: #667eea;
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.2);
}

.equipment-match-status {
  position: absolute;
  right: 6rpx;
  top: 50%;
  transform: translateY(-50%);
}

.match-status {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12rpx;
  font-weight: 600;
}

.match-status.matched {
  background: #28a745;
  color: #ffffff;
}

.match-status.unmatched {
  background: #ffc107;
  color: #ffffff;
}

/* 装备建议 */
.equipment-suggestions {
  margin-top: 6rpx;
  padding-top: 6rpx;
  border-top: 1rpx solid #e9ecef;
}

.suggestion-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 8rpx;
  background: #f8f9fa;
  border-radius: 4rpx;
  margin-bottom: 3rpx;
  cursor: pointer;
  transition: background-color 0.2s ease;
}

.suggestion-item:hover {
  background: #e9ecef;
}

.suggestion-icon {
  width: 20rpx;
  height: 20rpx;
  border-radius: 3rpx;
}

.suggestion-name {
  font-size: 18rpx;
  color: #2c3e50;
}

/* 兼容性样式 - 已移除旧的装备输入样式 */

.equipment-code-title {
  font-size: 26rpx;
  color: #333333;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.equipment-code-input {
  width: 100%;
  height: 70rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
  padding: 0 15rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  border: 2rpx solid #e9ecef;
  color: #333333;
}

/* 方案思路描述 */
.plan-desc-input {
  width: 100%;
  height: 250rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
  padding: 15rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  border: 2rpx solid #e9ecef;
  color: #333333;
}

/* 作者信息输入 */
.author-input {
  width: 100%;
  height: 70rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
  padding: 0 15rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  border: 2rpx solid #e9ecef;
  color: #333333;
}

/* 生成按钮 */
.btn-container {
  width: 100%;
  margin-top: 30rpx;
  margin-bottom: 50rpx;
}

.generate-btn {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: all 0.3s ease;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.3);
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.generate-btn:active {
  background: linear-gradient(135deg, #5a6fd8 0%, #6a4190 100%);
  transform: translateY(2rpx);
}

.hero-select-btn {
  width: 100%;
  height: 70rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  border-radius: 8rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 15rpx 0;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
}

.hero-select-btn:active {
  background: linear-gradient(135deg, #5a6fd8 0%, #6a4190 100%);
  transform: translateY(2rpx);
}

.hero-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.hero-name {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 600;
} 