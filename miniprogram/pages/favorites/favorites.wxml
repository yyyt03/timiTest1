<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">我的收藏</text>
    <text class="favorite-count">({{total}})</text>
  </view>

  <!-- 英雄分类选择器 -->
  <view class="hero-selector" wx:if="{{heroCategories.length > 0}}">
    <view class="selector-header" bindtap="toggleHeroSelector">
      <text class="selector-title">
        {{selectedHero === 'all' ? '全部英雄' : selectedHero}}
      </text>
      <text class="selector-count">({{total}})</text>
      <text class="selector-arrow {{showHeroSelector ? 'expanded' : ''}}">▼</text>
    </view>
    
    <!-- 英雄分类列表 -->
    <view class="hero-list {{showHeroSelector ? 'show' : ''}}" wx:if="{{showHeroSelector}}">
      <!-- 全部选项 -->
      <view class="hero-item {{selectedHero === 'all' ? 'selected' : ''}}" 
            bindtap="selectHero" data-hero="all">
        <text class="hero-name">全部英雄</text>
        <text class="hero-count">({{allFavorites.length}})</text>
      </view>
      
      <!-- 英雄选项 -->
      <view class="hero-item {{selectedHero === item.heroName ? 'selected' : ''}}" 
            wx:for="{{heroCategories}}" wx:key="heroName"
            bindtap="selectHero" data-hero="{{item.heroName}}">
        <text class="hero-name">{{item.heroName}}</text>
        <text class="hero-count">({{item.count}})</text>
      </view>
    </view>
  </view>

  <!-- 收藏列表 -->
  <view class="favorites-list" wx:if="{{favorites.length > 0}}">
    <view class="favorite-item" wx:for="{{favorites}}" wx:key="_id">
      <view class="plan-card" bindtap="viewPlan" data-plan-id="{{item.planId}}">
        <!-- 方案信息 -->
        <view class="plan-info">
          <view class="plan-header">
            <text class="plan-title">{{item.title || item.heroName + '方案'}}</text>
            <text class="hero-name">{{item.heroName || '未知英雄'}}</text>
          </view>
          
          <!-- 方案描述 -->
          <view class="plan-description" wx:if="{{item.description}}">
            <text class="description-text">{{item.description}}</text>
          </view>
          
          <!-- 重新布局：点赞收藏作者时间都在同一行 -->
          <view class="plan-stats-row">
            <view class="stat-badge like-badge">
              <text class="stat-icon">👍</text>
              <text class="stat-value">{{item.likeCount || 0}}</text>
            </view>
            <view class="stat-badge favorite-badge">
              <text class="stat-icon">⭐</text>
              <text class="stat-value">{{item.favoriteCount || 0}}</text>
            </view>
            <view class="meta-item author-item">
              <text class="meta-icon">👤</text>
              <text class="meta-value">{{item.creatorName || '匿名用户'}}</text>
            </view>
            <view class="meta-item time-item">
              <text class="meta-icon">🕒</text>
              <text class="meta-value">{{item.createTime}}</text>
            </view>
          </view>
        </view>
        
        <!-- 操作按钮 -->
        <view class="plan-actions">
          <view class="action-btn cancel-btn" 
                catchtap="cancelFavorite" 
                data-plan-id="{{item.planId}}" 
                data-index="{{index}}">
            <text class="btn-text">取消收藏</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && favorites.length === 0}}">
    <image class="empty-icon" src="{{emptyIcon}}" mode="aspectFit" binderror="onImageError"></image>
    <text class="empty-text">暂无收藏方案</text>
    <text class="empty-tip">去发现更多精彩方案吧</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore && !loading && favorites.length > 0}}">
    <text class="load-more-text">上拉加载更多</text>
  </view>

  <!-- 没有更多 -->
  <view class="no-more" wx:if="{{!hasMore && favorites.length > 0}}">
    <text class="no-more-text">没有更多了</text>
  </view>
</view> 