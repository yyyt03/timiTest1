/* 收藏页面样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 20rpx;
}

/* 页面标题 */
.page-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
  margin-bottom: 10rpx;
}

/* 英雄分类选择器 横向样式 */
.hero-selector {
  margin: 0 0 20rpx 0;
  background: #ffffff;
  border-radius: 8rpx;
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  border: 1rpx solid #e1e5e9;
  width: 100%;
}

/* 头部选择器样式，始终占满一行 */
.selector-header {
  display: flex;
  align-items: center;
  justify-content: center; /* 默认居中 */
  width: 100%;
  min-height: 60rpx;
  padding: 0rpx 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
  cursor: pointer;
  transition: background-color 0.2s ease;
  box-sizing: border-box;
}

.selector-header:active {
  background: #f8f9fa;
}

.selector-title {
  font-size: 24rpx;
  font-weight: 500;
  color: #1a1a1a;
  flex: 1;
  text-align: center; /* 默认居中 */
}

.selector-count {
  font-size: 20rpx;
  color: #666666;
  margin-left: 12rpx;
}

.selector-arrow {
  font-size: 16rpx;
  color: #999999;
  transition: transform 0.2s ease;
  margin-left: 16rpx;
}

.selector-arrow.expanded {
  transform: rotate(180deg);
}

/* 横向滚动英雄分类列表，展开前后都占满横向空间 */
.hero-list {
  display: flex;
  flex-direction: row;
  width: 100%;
  min-height: 60rpx;
  max-height: none;
  overflow-x: auto;
  overflow-y: hidden;
  padding: 8rpx 0 8rpx 8rpx;
  transition: none;
  scrollbar-width: none; /* Firefox */
  background: #fff;
  box-sizing: border-box;
}
.hero-list::-webkit-scrollbar {
  display: none; /* Chrome/Safari */
}

/* 横向英雄项 */
.hero-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  padding: 10rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  border: 1rpx solid #f0f0f0;
  background: #f8f9fa;
  transition: all 0.2s ease;
  position: relative;
  min-width: 120rpx;
  border-bottom: none;
  box-sizing: border-box;
  flex-shrink: 0;
}

.hero-item:last-child {
  margin-right: 0;
}

.hero-item.selected {
  background: #667eea;
  color: white;
  border: 1rpx solid #4a5568;
}

.hero-item.selected::before {
  display: none;
}

.hero-item:not(.selected):active {
  background: #e6e8f5;
}

.hero-item .hero-name {
  font-size: 22rpx;
  font-weight: 400;
  color: #333333;
  margin-right: 8rpx;
}

.hero-item.selected .hero-name {
  color: white;
  font-weight: 500;
}

.hero-item .hero-count {
  font-size: 18rpx;
  color: #888888;
  background: rgba(0, 0, 0, 0.05);
  padding: 2rpx 8rpx;
  border-radius: 10rpx;
}

.hero-item.selected .hero-count {
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.2);
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  margin-right: 10rpx;
}

.favorite-count {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 收藏列表 */
.favorites-list {
  width: 100%;
}

.favorite-item {
  margin-bottom: 30rpx;
}

.plan-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(10rpx);
  transition: all 0.3s ease;
}

.plan-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

/* 方案信息 */
.plan-info {
  margin-bottom: 20rpx;
}

.plan-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.hero-name {
  font-size: 24rpx;
  font-weight: 500;
  color: #888888;
  margin-left: 20rpx;
}

.plan-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  flex: 1;
}

.plan-description {
  margin-bottom: 16rpx;
}

/* 方案描述文本样式，最多显示4行，超出部分省略号显示 */
.description-text {
  font-size: 26rpx;
  color: #888888;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-word;
}

.plan-stats-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.stat-badge {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border: 1rpx solid #dee2e6;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.like-badge {
  background: linear-gradient(135deg, #fff5f5 0%, #ffe3e3 100%);
  border-color: #ffc9c9;
}

.favorite-badge {
  background: linear-gradient(135deg, #fff9db 0%, #fff3bf 100%);
  border-color: #ffec99;
}

.stat-icon {
  font-size: 20rpx;
  margin-right: 6rpx;
}

.stat-value {
  font-size: 24rpx;
  color: #333333;
  font-weight: 600;
}



.meta-item {
  display: flex;
  align-items: center;
  padding: 8rpx 12rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  border: 1rpx solid #e9ecef;
}

.author-item {
  background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
  border-color: #90caf9;
}

.time-item {
  background: linear-gradient(135deg, #f3e5f5 0%, #e1bee7 100%);
  border-color: #ce93d8;
}

.meta-icon {
  font-size: 20rpx;
  margin-right: 8rpx;
}

.meta-value {
  font-size: 22rpx;
  color: #333333;
  font-weight: 500;
}

/* 操作按钮 */
.plan-actions {
  display: flex;
  justify-content: flex-end;
}

.action-btn {
  padding: 16rpx 32rpx;
  border-radius: 50rpx;
  font-size: 24rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.cancel-btn {
  background: linear-gradient(45deg, #ff6b6b, #ee5a52);
  color: #ffffff;
}

.cancel-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.3);
}

.btn-text {
  color: inherit;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 20rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top: 4rpx solid #ffffff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 40rpx 0;
}

.load-more-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: 40rpx 0;
}

.no-more-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
} 