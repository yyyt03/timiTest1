/* 收藏页面样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 20rpx;
}

/* 页面标题 */
.page-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0;
  margin-bottom: 30rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  margin-right: 10rpx;
}

.favorite-count {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 收藏列表 */
.favorites-list {
  width: 100%;
}

.favorite-item {
  margin-bottom: 30rpx;
}

.plan-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(10rpx);
  transition: all 0.3s ease;
}

.plan-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

/* 方案信息 */
.plan-info {
  margin-bottom: 20rpx;
}

.plan-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.hero-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  background: linear-gradient(45deg, #667eea, #764ba2);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-right: 20rpx;
}

.plan-title {
  font-size: 28rpx;
  color: #666666;
  flex: 1;
}

.plan-description {
  margin-bottom: 16rpx;
}

.description-text {
  font-size: 26rpx;
  color: #888888;
  line-height: 1.6;
}

.plan-stats-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.stat-badge {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border: 1rpx solid #dee2e6;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.like-badge {
  background: linear-gradient(135deg, #fff5f5 0%, #ffe3e3 100%);
  border-color: #ffc9c9;
}

.favorite-badge {
  background: linear-gradient(135deg, #fff9db 0%, #fff3bf 100%);
  border-color: #ffec99;
}

.stat-icon {
  font-size: 20rpx;
  margin-right: 6rpx;
}

.stat-value {
  font-size: 24rpx;
  color: #333333;
  font-weight: 600;
}



.meta-item {
  display: flex;
  align-items: center;
  padding: 8rpx 12rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  border: 1rpx solid #e9ecef;
}

.author-item {
  background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
  border-color: #90caf9;
}

.time-item {
  background: linear-gradient(135deg, #f3e5f5 0%, #e1bee7 100%);
  border-color: #ce93d8;
}

.meta-icon {
  font-size: 20rpx;
  margin-right: 8rpx;
}

.meta-value {
  font-size: 22rpx;
  color: #333333;
  font-weight: 500;
}

/* 操作按钮 */
.plan-actions {
  display: flex;
  justify-content: flex-end;
}

.action-btn {
  padding: 16rpx 32rpx;
  border-radius: 50rpx;
  font-size: 24rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.cancel-btn {
  background: linear-gradient(45deg, #ff6b6b, #ee5a52);
  color: #ffffff;
}

.cancel-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.3);
}

.btn-text {
  color: inherit;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 20rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top: 4rpx solid #ffffff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 40rpx 0;
}

.load-more-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: 40rpx 0;
}

.no-more-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
} 