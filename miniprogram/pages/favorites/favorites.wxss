/* 收藏页面样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 20rpx;
}

/* 页面标题 */
.page-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
  margin-bottom: 10rpx;
}

/* 英雄分类选择器 横向样式 */
.hero-selector {
  margin: 0 24rpx 24rpx 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  border: 1rpx solid #f0f0f0;
  width: calc(100% - 48rpx);
  box-sizing: border-box;
  max-width: 100%; /* 确保不超过容器宽度 */
  transition: all 0.3s ease;
}

.hero-selector:hover {
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  transform: translateY(-2rpx);
}

/* 头部选择器样式，始终占满一行 */
.selector-header {
  display: flex;
  align-items: center;
  justify-content: center; /* 默认居中 */
  width: 100%;
  min-height: 88rpx; /* 增大高度 */
  padding: 0rpx 24rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  border-bottom: 1rpx solid #f0f0f0;
  cursor: pointer;
  transition: all 0.3s ease;
  box-sizing: border-box;
  position: relative;
}

.selector-header:active {
  background: linear-gradient(135deg, #f0f2f5 0%, #f8f9fa 100%);
  transform: scale(0.98);
}

.selector-header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 0;
  height: 3rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  transition: width 0.3s ease;
  transform: translateX(-50%);
}

.hero-selector:hover .selector-header::after {
  width: 60%;
}

.selector-title {
  font-size: 30rpx; /* 增大字体 */
  font-weight: 600;
  color: #2d3748;
  flex: 1;
  text-align: center; /* 默认居中 */
  letter-spacing: 0.5rpx;
}

.selector-count {
  font-size: 24rpx; /* 增大字体 */
  color: #667eea;
  margin-left: 16rpx;
  font-weight: 500;
  background: rgba(102, 126, 234, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.selector-arrow {
  font-size: 20rpx; /* 增大字体 */
  color: #667eea;
  transition: all 0.3s ease;
  margin-left: 20rpx;
  opacity: 0.8;
}

.selector-arrow.expanded {
  transform: rotate(180deg);
  opacity: 1;
  color: #764ba2;
}

/* 英雄列表网格布局 */
.hero-list {
  display: grid;
  grid-template-columns: repeat(6, 1fr); /* 固定每行6个英雄 */
  gap: 12rpx; /* 减小间距，让6个英雄能更好地适应 */
  padding: 16rpx; /* 减小内边距 */
  background: #fff;
  box-sizing: border-box;
  max-width: 100%;
  overflow: hidden;
  opacity: 0;
  transform: translateY(-20rpx);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  width: 100%;
}

.hero-list.show {
  opacity: 1;
  transform: translateY(0);
}

/* 英雄项样式 */
.hero-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 4rpx; /* 减小内边距 */
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
  box-sizing: border-box;
  background: transparent;
  border: none;
  position: relative;
  min-width: 80rpx; /* 减小最小宽度 */
  max-width: 100rpx; /* 减小最大宽度 */
  overflow: hidden;
}

.hero-item.selected {
  background: transparent;
  color: #667eea;
  border: none;
}

.hero-item:not(.selected):hover {
  transform: translateY(-4rpx);
}

.hero-item:not(.selected):active {
  background: transparent;
  transform: scale(0.95) translateY(-2rpx);
}

/* 英雄头像样式 */
.hero-avatar {
  width: 60rpx; /* 减小头像尺寸 */
  height: 60rpx;
  border-radius: 50%;
  background: #667eea;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 6rpx; /* 减小底部间距 */
  border: 2rpx solid #ffffff; /* 减小边框 */
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.25); /* 减小阴影 */
  overflow: hidden;
  position: relative;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  flex-shrink: 0;
}

.hero-item:hover .hero-avatar {
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.35);
  transform: scale(1.05);
}

.all-hero-avatar {
  background: #10b981;
}

.hero-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
}

.hero-item.selected .hero-avatar {
  background: #ffffff;
  border-color: #ffffff;
}

.hero-item .hero-name {
  font-size: 20rpx; /* 减小字体大小 */
  font-weight: 500;
  color: #4a5568;
  text-align: center;
  line-height: 1.2;
  margin-bottom: 0;
  transition: all 0.3s ease;
  word-break: break-all;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-item:hover .hero-name {
  color: #667eea;
  font-weight: 600;
}

.hero-item.selected .hero-name {
  color: #667eea;
  font-weight: 600;
}

.hero-item .hero-count {
  font-size: 18rpx;
  color: #888888;
  background: rgba(0, 0, 0, 0.05);
  padding: 2rpx 8rpx;
  border-radius: 10rpx;
}

.hero-item.selected .hero-count {
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.2);
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  margin-right: 10rpx;
}

.favorite-count {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 收藏列表 */
.favorites-list {
  width: 100%;
}

.favorite-item {
  margin-bottom: 30rpx;
}

.plan-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(10rpx);
  transition: all 0.3s ease;
}

.plan-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

/* 方案信息 */
.plan-info {
  margin-bottom: 20rpx;
}

.plan-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.hero-name {
  font-size: 24rpx;
  font-weight: 500;
  color: #888888;
  margin-left: 20rpx;
}

.plan-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  flex: 1;
}

.plan-description {
  margin-bottom: 16rpx;
}

/* 方案描述文本样式，最多显示4行，超出部分省略号显示 */
.description-text {
  font-size: 26rpx;
  color: #888888;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-word;
}

.plan-stats-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.stat-badge {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border: 1rpx solid #dee2e6;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.like-badge {
  background: linear-gradient(135deg, #fff5f5 0%, #ffe3e3 100%);
  border-color: #ffc9c9;
}

.favorite-badge {
  background: linear-gradient(135deg, #fff9db 0%, #fff3bf 100%);
  border-color: #ffec99;
}

.stat-icon {
  font-size: 20rpx;
  margin-right: 6rpx;
}

.stat-value {
  font-size: 24rpx;
  color: #333333;
  font-weight: 600;
}



.meta-item {
  display: flex;
  align-items: center;
  padding: 8rpx 12rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  border: 1rpx solid #e9ecef;
}

.author-item {
  background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
  border-color: #90caf9;
}

.time-item {
  background: linear-gradient(135deg, #f3e5f5 0%, #e1bee7 100%);
  border-color: #ce93d8;
}

.meta-icon {
  font-size: 20rpx;
  margin-right: 8rpx;
}

.meta-value {
  font-size: 22rpx;
  color: #333333;
  font-weight: 500;
}

/* 操作按钮 */
.plan-actions {
  display: flex;
  justify-content: flex-end;
}

.action-btn {
  padding: 16rpx 32rpx;
  border-radius: 50rpx;
  font-size: 24rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.cancel-btn {
  background: linear-gradient(45deg, #ff6b6b, #ee5a52);
  color: #ffffff;
}

.cancel-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.3);
}

.btn-text {
  color: inherit;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 20rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top: 4rpx solid #ffffff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 40rpx 0;
}

.load-more-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: 40rpx 0;
}

.no-more-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
} 

/* 响应式设计：小屏幕设备 */
@media screen and (max-width: 750rpx) {
  .hero-selector {
    margin: 0 12rpx 12rpx 12rpx;
    width: calc(100% - 24rpx);
    border-radius: 16rpx;
  }
  
  .selector-header {
    min-height: 72rpx;
    padding: 0rpx 16rpx;
  }
  
  .selector-title {
    font-size: 26rpx;
  }
  
  .selector-count {
    font-size: 20rpx;
    padding: 2rpx 8rpx;
    margin-left: 12rpx;
  }
  
  .selector-arrow {
    font-size: 18rpx;
    margin-left: 16rpx;
  }
  
  .hero-list {
    grid-template-columns: repeat(6, 1fr); /* 小屏幕下仍然保持6个 */
    gap: 8rpx; /* 进一步减小间距 */
    padding: 12rpx; /* 减小内边距 */
    overflow: hidden;
  }
  
  .hero-item {
    padding: 6rpx 2rpx; /* 减小内边距 */
  }
  
  .hero-avatar {
    width: 50rpx; /* 减小头像尺寸 */
    height: 50rpx;
    margin-bottom: 4rpx; /* 减小底部间距 */
    border: 2rpx solid #ffffff;
  }
  
  .hero-item .hero-name {
    font-size: 16rpx; /* 减小字体大小 */
    margin-bottom: 0;
  }
}

/* 响应式设计：超小屏幕设备 */
@media screen and (max-width: 600rpx) {
  .hero-selector {
    margin: 0 8rpx 8rpx 8rpx;
    width: calc(100% - 16rpx);
  }
  
  .hero-list {
    grid-template-columns: repeat(6, 1fr); /* 超小屏幕下仍然保持6个 */
    gap: 6rpx; /* 进一步减小间距 */
    padding: 10rpx; /* 减小内边距 */
  }
  
  .hero-avatar {
    width: 45rpx; /* 进一步减小头像尺寸 */
    height: 45rpx;
  }
  
  .hero-item .hero-name {
    font-size: 14rpx; /* 进一步减小字体大小 */
  }
}

/* 中等屏幕优化 */
@media screen and (min-width: 751rpx) and (max-width: 900rpx) {
  .hero-list {
    grid-template-columns: repeat(6, 1fr); /* 中等屏幕下保持6个 */
    gap: 14rpx; /* 适当增加间距 */
    padding: 18rpx; /* 适当增加内边距 */
  }
  
  .hero-avatar {
    width: 65rpx; /* 适当增加头像尺寸 */
    height: 65rpx;
  }
}

/* 大屏幕优化 */
@media screen and (min-width: 901rpx) {
  .hero-list {
    grid-template-columns: repeat(6, 1fr); /* 大屏幕下保持6个 */
    gap: 16rpx; /* 适当增加间距 */
    padding: 20rpx; /* 适当增加内边距 */
  }
  
  .hero-avatar {
    width: 70rpx; /* 适当增加头像尺寸 */
    height: 70rpx;
  }
}

/* 确保内容不会超出容器边界 */
.hero-selector {
  max-width: 100vw;
  overflow: hidden;
}

.hero-list {
  max-width: 100%;
  overflow: hidden;
}

.hero-item {
  max-width: 100%;
  overflow: hidden;
}

.hero-avatar {
  max-width: 100%;
  overflow: hidden;
}

.hero-avatar-img {
  max-width: 100%;
  max-height: 100%;
} 