.container {
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 截图提示 */
.screenshot-tip {
  text-align: center;
  margin: 20rpx 30rpx;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.tip-text {
  font-size: 28rpx;
  color: #666;
}

/* 方案卡片 */
.plan-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 0 30rpx 30rpx 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

/* 英雄信息头部 */
.hero-section {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 20rpx 30rpx;
  margin: 0 -30rpx 30rpx -30rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.3);
  border-radius: 20rpx 20rpx 0 0;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
}

.hero-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  margin-right: 20rpx;
  border: 3rpx solid #667eea;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.2);
}

.hero-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.hero-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 6rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.plan-title {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

/* 通用区块样式 */
.section {
  margin-bottom: 30rpx;
}

.section-title {
  margin-bottom: 20rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 15rpx;
  padding-left: 15rpx;
  border-left: 4rpx solid #667eea;
  display: block;
  line-height: 1.2;
}

/* 技能配置 - 参考planDetail样式 */
.skills-container {
  display: flex;
  flex-direction: column;
  padding: 0 30rpx;
  gap: 6rpx;
}

.skill-column {
  width: 100%;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-radius: 16rpx;
  border: 1rpx solid #e9ecef;
  padding: 12rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.skill-layout {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
  height: 100%;
}

.skill-name-section {
  width: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 12rpx;
  border: none;
  padding: 10rpx 6rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.skill-name-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
  text-align: center;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
}

.skill-content-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.skill-core {
  display: flex;
  align-items: flex-start;
  padding: 8rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 12rpx;
  border: 2rpx solid #667eea;
  margin-bottom: 4rpx;
  position: relative;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.1);
}

.skill-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.skill-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.skill-desc {
  font-size: 22rpx;
  color: #34495e;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-all;
}

.skill-tag {
  font-size: 14rpx;
  color: #667eea;
  background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
  padding: 3rpx 6rpx;
  border-radius: 6rpx;
  align-self: flex-start;
  margin-bottom: 3rpx;
  font-weight: 600;
}

.skill-talents {
  display: flex;
  flex-direction: column;
  gap: 3rpx;
}

.talent-item {
  display: flex;
  align-items: flex-start;
  padding: 6rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 10rpx;
  border: 1rpx solid #e9ecef;
  position: relative;
  transition: all 0.2s ease;
}

.talent-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.talent-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.talent-desc {
  font-size: 22rpx;
  color: #34495e;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-all;
}

.talent-tag {
  font-size: 14rpx;
  color: #667eea;
  background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
  padding: 3rpx 6rpx;
  border-radius: 6rpx;
  align-self: flex-start;
  margin-bottom: 3rpx;
  font-weight: 600;
}

/* 出装推荐 */
.equipment-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.equipment-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-radius: 12rpx;
  border: 1rpx solid #e9ecef;
  transition: all 0.3s ease;
}

.equipment-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-bottom: 8rpx;
  border: 2rpx solid #e9ecef;
}

.equipment-name {
  font-size: 22rpx;
  color: #333;
  text-align: center;
  line-height: 1.2;
}

/* 玩法 */
.strategy-content {
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-radius: 12rpx;
  padding: 20rpx;
  border: 1rpx solid #e9ecef;
}

.strategy-text {
  font-size: 28rpx;
  color: #34495e;
  line-height: 1.6;
  word-wrap: break-word;
  white-space: normal;
}

/* 底部信息 */
.footer {
  text-align: center;
  padding-top: 20rpx;
  border-top: 2rpx solid #f0f0f0;
}

.footer-text {
  font-size: 24rpx;
  color: #999;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  border-top: 1rpx solid rgba(0, 0, 0, 0.1);
}

.action-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
}

.action-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
}

.action-btn.primary:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.4);
} 