          </view>
          <text class="hero-name">{{item}}</text>
        </view>
      </block>
    </view>
  </view>
  
  <!-- 战士分类 -->
  <view class="hero-category">
    <view class="category-header">战士</view>
    <view class="hero-grid">
      <block wx:for="{{heroCategories.warrior.heroes}}" wx:key="index">
        <view class="hero-item" bindtap="selectHero" data-hero="{{item}}">
          <view class="hero-avatar-container">
            <image class="hero-avatar" src="../images/user.png" mode="aspectFit"></image>
          </view>
          <text class="hero-name">{{item}}</text>
        </view>
      </block>
    </view>
  </view>
  
  <!-- 法师分类 -->
  <view class="hero-category">
    <view class="category-header">法师</view>
