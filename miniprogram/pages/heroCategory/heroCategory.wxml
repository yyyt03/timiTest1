<view class="container">
  <view class="category-title">英雄分类</view>
  
  <view class="category-list">
    <!-- 射手 -->
    <view class="category-item" bindtap="showHeroes" data-type="shooter">
      <view class="category-icon-container">
        <image class="category-icon" src="../images/strategy.png" mode="aspectFit"></image>
      </view>
      <text class="category-name">射手</text>
    </view>
    
    <!-- 辅助 -->
    <view class="category-item" bindtap="showHeroes" data-type="support">
      <view class="category-icon-container">
        <image class="category-icon" src="../images/strategy.png" mode="aspectFit"></image>
      </view>
      <text class="category-name">辅助</text>
    </view>
    
    <!-- 刺客 -->
    <view class="category-item" bindtap="showHeroes" data-type="assassin">
      <view class="category-icon-container">
        <image class="category-icon" src="../images/strategy.png" mode="aspectFit"></image>
      </view>
      <text class="category-name">刺客</text>
    </view>
    
    <!-- 战士 -->
    <view class="category-item" bindtap="showHeroes" data-type="warrior">
      <view class="category-icon-container">
        <image class="category-icon" src="../images/strategy.png" mode="aspectFit"></image>
      </view>
      <text class="category-name">战士</text>
    </view>
    
    <!-- 法师 -->
    <view class="category-item" bindtap="showHeroes" data-type="mage">
      <view class="category-icon-container">
        <image class="category-icon" src="../images/strategy.png" mode="aspectFit"></image>
      </view>
      <text class="category-name">法师</text>
    </view>
  </view>
  
  <!-- 英雄列表 -->
  <view class="hero-list" wx:if="{{showHeroList}}">
    <view class="hero-list-title">{{currentCategoryName}}</view>
    <view class="hero-grid">
      <block wx:for="{{heroList}}" wx:key="index">
        <view class="hero-item" bindtap="selectHero" data-hero="{{item}}">
          <view class="hero-avatar-container">
            <image class="hero-avatar" src="../images/user.png" mode="aspectFit"></image>
          </view>
          <text class="hero-name">{{item}}</text>
        </view>
      </block>
    </view>
  </view>
</view> 