<view class="container">
  <view class="category-title">选择英雄</view>
  
  <!-- 射手分类 -->
  <view class="hero-category">
    <view class="category-header">射手</view>
    <view class="hero-grid">
      <block wx:for="{{heroCategories.shooter.heroes}}" wx:key="index">
        <view class="hero-item" bindtap="selectHero" data-hero="{{item}}">
          <view class="hero-avatar-container">
            <image class="hero-avatar" src="../images/user.png" mode="aspectFit"></image>
          </view>
          <text class="hero-name">{{item}}</text>
        </view>
      </block>
    </view>
  </view>
  
  <!-- 辅助分类 -->
  <view class="hero-category">
    <view class="category-header">辅助</view>
    <view class="hero-grid">
      <block wx:for="{{heroCategories.support.heroes}}" wx:key="index">
