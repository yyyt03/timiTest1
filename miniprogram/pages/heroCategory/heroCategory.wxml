<view class="container">
  <view class="category-title">选择英雄</view>
  
  <!-- 加载中 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-text">加载中...</view>
  </view>
  
  <!-- 英雄分类列表 -->
  <block wx:else>
    <block wx:for="{{heroCategories}}" wx:key="categoryKey" wx:for-index="categoryKey">
      <view class="hero-category">
        <view class="category-header">{{item.name}}</view>
        <view class="hero-grid">
          <block wx:for="{{item.heroes}}" wx:key="id" wx:for-item="hero">
            <view class="hero-item" bindtap="selectHero" data-hero="{{hero}}">
              <view class="hero-avatar-container">
                <image class="hero-avatar" src="{{hero.avatar}}" mode="aspectFill"></image>
              </view>
              <text class="hero-name">{{hero.name}}</text>
            </view>
          </block>
        </view>
      </view>
    </block>
  </block>
</view> 