/* 英雄分类页面样式 */
.container {
  padding: 20rpx;
  box-sizing: border-box;
  background-color: #ffffff;
  min-height: 100vh;
}

.category-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin: 15rpx 0 25rpx 0;
  align-self: flex-start;
  padding-left: 10rpx;
  border-left: 6rpx solid #000000;
}

/* 英雄分类 */
.hero-category {
  width: 100%;
  margin-bottom: 25rpx;
}

.category-header {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin: 15rpx 0 10rpx 0;
  padding-left: 15rpx;
  border-left: 6rpx solid #000000;
  background-color: #f8f9fa;
  padding: 12rpx;
  border-radius: 8rpx;
}

/* 英雄网格 */
.hero-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  margin-top: 15rpx;
}

.hero-item {
  width: 16.66%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.hero-avatar-container {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #ffffff;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 10rpx;
  overflow: hidden;
  border: 2rpx solid #e9ecef;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.hero-avatar-container:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
  border-color: #000000;
}

.hero-avatar {
  width: 100rpx;
  height: 100rpx;
  object-fit: cover;
}

.hero-name {
  font-size: 22rpx;
  color: #333333;
  text-align: center;
  font-weight: 500;
}

/* 加载状态样式 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 200rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999999;
} 