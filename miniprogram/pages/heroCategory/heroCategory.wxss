.container {
  padding: 30rpx;
  box-sizing: border-box;
  background-color: #ffffff;
  min-height: 100vh;
}

.category-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
  margin: 20rpx 0 40rpx 0;
  align-self: flex-start;
  padding-left: 10rpx;
  border-left: 6rpx solid #000000;
}

.category-list {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.category-item {
  width: 30%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.category-icon-container {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #f8f9fa;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 15rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid #e9ecef;
  transition: all 0.3s ease;
}

.category-icon-container:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.category-icon {
  width: 70rpx;
  height: 70rpx;
}

.category-icon-text {
  color: #333333;
  font-size: 50rpx;
  font-weight: bold;
}

.category-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

/* 英雄列表 */
.hero-list {
  width: 100%;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid #f0f0f0;
}

.hero-list-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 30rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.hero-category {
  width: 100%;
  margin-bottom: 40rpx;
}

.category-header {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin: 20rpx 0 15rpx 0;
  padding-left: 15rpx;
  border-left: 6rpx solid #000000;
  background-color: #f8f9fa;
  padding: 15rpx;
  border-radius: 8rpx;
}

.hero-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  margin-top: 20rpx;
}

.hero-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.hero-avatar-container {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #ffffff;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 15rpx;
  overflow: hidden;
  border: 2rpx solid #e9ecef;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.hero-avatar-container:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
  border-color: #000000;
}

.hero-avatar {
  width: 110rpx;
  height: 110rpx;
}

.hero-avatar-text {
  color: #333333;
  font-size: 40rpx;
  font-weight: bold;
}

.hero-name {
  font-size: 24rpx;
  color: #333333;
  text-align: center;
  font-weight: 500;
}

/* 加载状态样式 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 200rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999999;
} 