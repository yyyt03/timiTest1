.container {
  padding: 20rpx;
  box-sizing: border-box;
  background-color: #1a1a2e;
  min-height: 100vh;
}

.category-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
  margin: 20rpx 0;
  align-self: flex-start;
  padding-left: 10rpx;
}

.category-list {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.category-item {
  width: 30%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.category-icon-container {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #4A90E2;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 15rpx;
  box-shadow: 0 4rpx 10rpx rgba(74, 144, 226, 0.3);
}

.category-icon {
  width: 70rpx;
  height: 70rpx;
}

.category-icon-text {
  color: #ffffff;
  font-size: 50rpx;
  font-weight: bold;
}

.category-name {
  font-size: 28rpx;
  color: #333333;
}

/* 英雄列表 */
.hero-list {
  width: 100%;
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.hero-list-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 30rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #eaeaea;
}

.hero-category {
  width: 100%;
  margin-bottom: 30rpx;
}

.category-header {
  font-size: 36rpx;
  font-weight: bold;
  color: #e0e0e0;
  margin: 10rpx 0;
  padding-left: 10rpx;
  border-left: 8rpx solid #8e2de2;
}

.hero-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
}

.hero-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.hero-avatar-container {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #2c2c54;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 10rpx;
  overflow: hidden;
  border: 4rpx solid #4a00e0;
}

.hero-avatar {
  width: 110rpx;
  height: 110rpx;
}

.hero-avatar-text {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: bold;
}

.hero-name {
  font-size: 24rpx;
  color: #e0e0e0;
  text-align: center;
} 