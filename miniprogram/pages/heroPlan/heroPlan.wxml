<view class="container">
  <view class="hero-header">
    <view class="hero-avatar-container">
      <image class="hero-avatar" src="{{heroAvatar}}" mode="aspectFit"></image>
    </view>
    <view class="hero-name">{{hero}}</view>
  </view>
  
  <view class="action-bar">
    <button class="create-btn" bindtap="createPlan">创建新方案</button>
  </view>
  
  <!-- 方案列表 -->
  <view class="plans-section">
    <!-- 加载中 -->
    <view class="loading-container" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <view class="loading-text">加载中...</view>
    </view>
    
    <!-- 方案列表 -->
    <view class="plans-grid" wx:else>
      <view class="plan-card" wx:for="{{plans}}" wx:key="_id" wx:for-index="index" bindtap="viewPlan" data-id="{{item._id}}" data-index="{{index}}">
        <!-- 方案头部 -->
        <view class="plan-header">
          <view class="plan-info">
            <view class="plan-title">{{item.title}}</view>
            <view class="plan-hero-name">{{hero}}</view>
          </view>
          <view class="plan-stats">
            <view class="stat-item" catchtap="toggleLike" data-id="{{item._id}}" data-index="{{index}}">
              <image class="stat-icon" src="{{item.isLiked ? likeFilledIcon : likeOutlineIcon}}" mode="aspectFit"></image>
              <text class="stat-text">{{item.likeCount || 0}}</text>
            </view>
            <view class="stat-item" catchtap="toggleFavorite" data-id="{{item._id}}" data-index="{{index}}">
              <image class="stat-icon" src="{{item.isFavorited ? favoriteFilledIcon : favoriteOutlineIcon}}" mode="aspectFit"></image>
              <text class="stat-text">{{item.favoriteCount || 0}}</text>
            </view>
          </view>
        </view>
        
        <!-- 方案描述 -->
        <view class="plan-description">{{item.description || '这是一个精心设计的方案，适合当前版本使用。'}}</view>
        
        <!-- 方案标签 -->
        <view class="plan-tags">
          <view class="tag" wx:if="{{item.difficulty}}">{{item.difficulty}}</view>
          <view class="tag" wx:if="{{item.style}}">{{item.style}}</view>
          <view class="tag" wx:if="{{item.role}}">{{item.role}}</view>
        </view>
        
        <!-- 方案底部 -->
        <view class="plan-footer">
          <view class="plan-author">
            <text class="author-text">作者：{{item.creatorName || '匿名用户'}}</text>
          </view>
          <view class="plan-time">🕒 {{item.createTime}}</view>
        </view>
      </view>
    </view>
    
    <!-- 无数据提示 -->
    <view class="no-data" wx:if="{{!loading && plans.length === 0}}">
      <image class="no-data-icon" src="{{emptyIcon}}" mode="aspectFit"></image>
      <view class="no-data-text">暂无方案</view>
      <view class="no-data-tip">点击上方按钮创建新方案</view>
    </view>
    
    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{loadingMore}}">
      <view class="loading-spinner"></view>
      <view class="loading-text">加载中...</view>
    </view>
    
    <!-- 没有更多数据 -->
    <view class="no-more" wx:if="{{!hasMore && plans.length > 0}}">
      <view class="no-more-text">没有更多数据了</view>
    </view>
  </view>
</view> 