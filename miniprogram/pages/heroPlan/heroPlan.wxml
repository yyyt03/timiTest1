<view class="container">
  <view class="hero-header">
    <view class="hero-avatar-container">
      <image class="hero-avatar" src="{{heroAvatar}}" mode="aspectFit"></image>
    </view>
    <view class="hero-name">{{hero}}</view>
  </view>
  
  <view class="action-bar">
    <button class="create-btn" bindtap="createPlan">创建新方案</button>
  </view>
  
  <view class="plans-container">
    <!-- 加载中 -->
    <view class="loading-container" wx:if="{{loading}}">
      <view class="loading-text">加载中...</view>
    </view>
    
    <!-- 无方案提示 -->
    <view class="no-plans-container" wx:elif="{{noPlans}}">
      <view class="no-plans-text">暂无方案</view>
      <view class="no-plans-tip">点击上方按钮创建新方案</view>
    </view>
    
    <!-- 方案列表 -->
    <block wx:else>
      <view class="plan-card" wx:for="{{plans}}" wx:key="_id" wx:for-index="index">
        <view class="plan-header">
          <view class="plan-title">{{item.title}}</view>
          <view class="plan-actions">
            <view class="action-item" catchtap="toggleFavorite" data-id="{{item._id}}" data-index="{{index}}">
              <image class="action-icon {{item.isFavorited ? 'favorited' : ''}}" 
                     src="{{item.isFavorited ? favoriteFilledIcon : favoriteOutlineIcon}}" 
                     mode="aspectFit"></image>
              <text class="action-count">{{item.favorites || 0}}</text>
            </view>
            <view class="action-item">
              <image class="action-icon" src="{{likeOutlineIcon}}" mode="aspectFit"></image>
              <text class="action-count">{{item.likes || 0}}</text>
            </view>
          </view>
        </view>
        
        <view class="plan-content" bindtap="viewPlan" data-id="{{item._id}}">
          <view class="plan-info">
            <view class="info-item">
              <text class="info-label">核心:</text>
              <text class="info-value">{{item.coreSkill}}</text>
            </view>
            <view class="info-item" wx:if="{{item.talents && item.talents.length > 0}}">
              <text class="info-label">特性:</text>
              <text class="info-value">{{item.talents.join(', ')}}</text>
            </view>
            <view class="info-item">
              <text class="info-label">出装:</text>
              <text class="info-value">{{item.equipment}}</text>
            </view>
            <view class="info-item" wx:if="{{item.equipmentCode}}">
              <text class="info-label">密语:</text>
              <text class="info-value">{{item.equipmentCode}}</text>
            </view>
          </view>
          
          <view class="plan-desc" wx:if="{{item.strategy}}">
            <text class="desc-label">思路:</text>
            <text class="desc-content">{{item.strategy}}</text>
          </view>
        </view>
        
        <view class="plan-footer">
          <text class="plan-author">{{item.creatorName || '匿名用户'}}</text>
          <text class="plan-time">{{item.createTime}}</text>
        </view>
      </view>
      
      <!-- 加载更多 -->
      <view class="load-more" wx:if="{{loadingMore}}">
        <view class="loading-text">加载中...</view>
      </view>
      
      <!-- 没有更多数据 -->
      <view class="no-more" wx:if="{{!hasMore && plans.length > 0}}">
        <view class="no-more-text">没有更多数据了</view>
      </view>
    </block>
  </view>
</view> 