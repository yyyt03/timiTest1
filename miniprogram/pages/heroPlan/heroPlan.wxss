.container {
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
}

/* 英雄头部 */
.hero-header {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 0;
  margin-bottom: 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.3);
  position: relative;
  overflow: hidden;
}

.hero-avatar-container {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background-color: #ffffff;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 20rpx;
  overflow: hidden;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.hero-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  object-fit: cover;
}

.hero-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

/* 操作栏 */
.action-bar {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-bottom: 30rpx;
}

.create-btn {
  width: 80%;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: all 0.3s ease;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.3);
  border: none;
}

.create-btn:active {
  background: linear-gradient(135deg, #5a6fd8 0%, #6a4190 100%);
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.4);
}

/* 方案容器 */
.plans-container {
  width: 100%;
}

/* 加载中 */
.loading-container {
  width: 100%;
  height: 200rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.loading-text {
  font-size: 30rpx;
  color: #666666;
}

/* 无方案提示 */
.no-plans-container {
  width: 100%;
  height: 300rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #f8f9fa;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.no-plans-text {
  font-size: 32rpx;
  color: #333333;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.no-plans-tip {
  font-size: 26rpx;
  color: #666666;
}

/* 方案卡片 */
.plan-card {
  width: 100%;
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  padding: 0;
  box-sizing: border-box;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  transition: all 0.3s ease;
  overflow: hidden;
}

.plan-card:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

/* 方案标题区域 */
.plan-title-area {
  padding: 30rpx 30rpx 20rpx 30rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  border-bottom: 1rpx solid #e9ecef;
  transition: all 0.2s ease;
}

.plan-title-area:active {
  background: linear-gradient(135deg, #e9ecef 0%, #f8f9fa 100%);
  transform: scale(0.98);
}

.plan-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c3e50;
  line-height: 1.4;
  display: block;
}

/* 操作按钮区域 */
.plan-actions-area {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-bottom: 1rpx solid #e9ecef;
}

.action-item {
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border: 1rpx solid #e9ecef;
  transition: all 0.2s ease;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  position: relative;
  z-index: 10;
}

.action-item:active {
  background: linear-gradient(135deg, #e9ecef 0%, #dee2e6 100%);
  transform: scale(0.95);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.1);
}

.action-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
  transition: all 0.3s ease;
}

.action-icon.favorited {
  filter: drop-shadow(0 2rpx 4rpx rgba(255, 193, 7, 0.3));
}

.action-icon.liked {
  filter: drop-shadow(0 2rpx 4rpx rgba(220, 53, 69, 0.3));
}

.action-count {
  font-size: 26rpx;
  color: #495057;
  font-weight: 600;
  min-width: 20rpx;
  text-align: center;
}

/* 方案内容 - 已移除，不再需要 */

.info-item {
  display: flex;
  margin-bottom: 10rpx;
}

.info-label {
  font-size: 26rpx;
  color: #666666;
  width: 80rpx;
  font-weight: 500;
}

.info-value {
  font-size: 26rpx;
  color: #333333;
  flex: 1;
}

.plan-desc {
  background-color: #f8f9fa;
  padding: 20rpx;
  border-radius: 8rpx;
  border: 1rpx solid #e9ecef;
}

.desc-label {
  font-size: 26rpx;
  color: #666666;
  margin-right: 10rpx;
  font-weight: 500;
}

.desc-content {
  font-size: 26rpx;
  color: #333333;
  line-height: 1.5;
}

/* 方案底部 */
.plan-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  border-top: 1rpx solid #e9ecef;
}

.plan-author {
  font-size: 26rpx;
  color: #6c757d;
  font-weight: 500;
  display: flex;
  align-items: center;
}

.plan-author::before {
  content: '👤';
  margin-right: 8rpx;
  font-size: 24rpx;
}

.plan-time {
  font-size: 26rpx;
  color: #6c757d;
  font-weight: 500;
  display: flex;
  align-items: center;
}

.plan-time::before {
  content: '🕒';
  margin-right: 8rpx;
  font-size: 24rpx;
}

/* 加载更多 */
.load-more {
  width: 100%;
  height: 100rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 20rpx;
}

/* 没有更多数据 */
.no-more {
  width: 100%;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 20rpx;
}

.no-more-text {
  font-size: 26rpx;
  color: #999999;
} 