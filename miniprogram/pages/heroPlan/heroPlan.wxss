.container {
  padding: 30rpx;
  box-sizing: border-box;
  background-color: #ffffff;
  min-height: 100vh;
}

/* 英雄头部 */
.hero-header {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 0;
  margin-bottom: 30rpx;
  background-color: #f8f9fa;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.hero-avatar-container {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background-color: #ffffff;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 20rpx;
  overflow: hidden;
  border: 3rpx solid #e9ecef;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.hero-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  object-fit: cover;
}

.hero-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}

/* 操作栏 */
.action-bar {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-bottom: 30rpx;
}

.create-btn {
  width: 80%;
  height: 80rpx;
  background-color: #000000;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.create-btn:active {
  background-color: #333333;
  transform: translateY(2rpx);
}

/* 方案容器 */
.plans-container {
  width: 100%;
}

/* 加载中 */
.loading-container {
  width: 100%;
  height: 200rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.loading-text {
  font-size: 30rpx;
  color: #666666;
}

/* 无方案提示 */
.no-plans-container {
  width: 100%;
  height: 300rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #f8f9fa;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.no-plans-text {
  font-size: 32rpx;
  color: #333333;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.no-plans-tip {
  font-size: 26rpx;
  color: #666666;
}

/* 方案卡片 */
.plan-card {
  width: 100%;
  background-color: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  padding: 30rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid #f0f0f0;
  transition: all 0.3s ease;
}

.plan-card:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

/* 方案头部 */
.plan-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.plan-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.plan-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.action-item {
  display: flex;
  align-items: center;
  padding: 8rpx 12rpx;
  border-radius: 20rpx;
  background-color: #f8f9fa;
  transition: all 0.3s ease;
}

.action-item:active {
  background-color: #e9ecef;
  transform: scale(0.95);
}

.action-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  transition: all 0.3s ease;
}

.action-icon.favorited {
  filter: brightness(0) saturate(100%) invert(27%) sepia(51%) saturate(2878%) hue-rotate(346deg) brightness(104%) contrast(97%);
}

.action-count {
  font-size: 24rpx;
  color: #666666;
  font-weight: 500;
}

/* 方案内容 */
.plan-content {
  margin-bottom: 20rpx;
}

.plan-info {
  margin-bottom: 20rpx;
}

.info-item {
  display: flex;
  margin-bottom: 10rpx;
}

.info-label {
  font-size: 26rpx;
  color: #666666;
  width: 80rpx;
  font-weight: 500;
}

.info-value {
  font-size: 26rpx;
  color: #333333;
  flex: 1;
}

.plan-desc {
  background-color: #f8f9fa;
  padding: 20rpx;
  border-radius: 8rpx;
  border: 1rpx solid #e9ecef;
}

.desc-label {
  font-size: 26rpx;
  color: #666666;
  margin-right: 10rpx;
  font-weight: 500;
}

.desc-content {
  font-size: 26rpx;
  color: #333333;
  line-height: 1.5;
}

/* 方案底部 */
.plan-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 15rpx;
  border-top: 1rpx solid #f0f0f0;
}

.plan-author {
  font-size: 24rpx;
  color: #666666;
}

.plan-time {
  font-size: 24rpx;
  color: #666666;
}

/* 加载更多 */
.load-more {
  width: 100%;
  height: 100rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 20rpx;
}

/* 没有更多数据 */
.no-more {
  width: 100%;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 20rpx;
}

.no-more-text {
  font-size: 26rpx;
  color: #999999;
} 