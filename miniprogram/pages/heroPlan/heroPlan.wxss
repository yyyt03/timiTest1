.container {
  padding: 20rpx;
  box-sizing: border-box;
  background-color: #1a1a2e;
  min-height: 100vh;
}

/* 英雄头部 */
.hero-header {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 0;
  margin-bottom: 20rpx;
}

.hero-avatar-container {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background-color: #2c2c54;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 20rpx;
  overflow: hidden;
  border: 4rpx solid #4a00e0;
}

.hero-avatar {
  width: 140rpx;
  height: 140rpx;
}

.hero-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
}

/* 操作栏 */
.action-bar {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-bottom: 30rpx;
}

.create-btn {
  width: 80%;
  height: 80rpx;
  background: linear-gradient(to right, #8e2de2, #4a00e0);
  color: #ffffff;
  font-size: 30rpx;
  border-radius: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 方案容器 */
.plans-container {
  width: 100%;
}

/* 加载中 */
.loading-container {
  width: 100%;
  height: 200rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.loading-text {
  font-size: 30rpx;
  color: #8a8a8a;
}

/* 无方案提示 */
.no-plans-container {
  width: 100%;
  height: 300rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.no-plans-text {
  font-size: 32rpx;
  color: #e0e0e0;
  margin-bottom: 20rpx;
}

.no-plans-tip {
  font-size: 26rpx;
  color: #8a8a8a;
}

/* 方案卡片 */
.plan-card {
  width: 100%;
  background-color: #2c2c54;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  padding: 20rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

/* 方案头部 */
.plan-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #4a00e0;
}

.plan-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #e0e0e0;
}

.plan-likes {
  display: flex;
  align-items: center;
}

.like-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
}

/* 方案内容 */
.plan-content {
  margin-bottom: 20rpx;
}

.plan-info {
  margin-bottom: 20rpx;
}

.info-item {
  display: flex;
  margin-bottom: 10rpx;
}

.info-label {
  font-size: 26rpx;
  color: #8a8a8a;
  width: 80rpx;
}

.info-value {
  font-size: 26rpx;
  color: #e0e0e0;
  flex: 1;
}

.plan-desc {
  background-color: #1a1a2e;
  padding: 15rpx;
  border-radius: 8rpx;
}

.desc-label {
  font-size: 26rpx;
  color: #8a8a8a;
  margin-right: 10rpx;
}

.desc-content {
  font-size: 26rpx;
  color: #e0e0e0;
  line-height: 1.5;
}

/* 方案底部 */
.plan-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 15rpx;
  border-top: 1rpx solid #3a3a6a;
}

.plan-author {
  font-size: 24rpx;
  color: #8a8a8a;
}

.plan-time {
  font-size: 24rpx;
  color: #8a8a8a;
} 