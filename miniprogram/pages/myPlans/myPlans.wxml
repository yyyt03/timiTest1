<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">{{pageTitle}}</text>
    <text class="plan-count">({{total}})</text>
  </view>

  <!-- 管理员状态筛选，仅管理员审核模式显示 -->
  <view wx:if="{{isAdminReview}}" class="admin-filters">
    <view class="filter-btn {{adminStatusFilter === 'all' ? 'active' : ''}}" data-status="all" bindtap="switchAdminStatus">全部</view>
    <view class="filter-btn {{adminStatusFilter === 'draft' ? 'active' : ''}}" data-status="draft" bindtap="switchAdminStatus">草稿</view>
    <view class="filter-btn {{adminStatusFilter === 'pending' ? 'active' : ''}}" data-status="pending" bindtap="switchAdminStatus">审核中</view>
    <view class="filter-btn {{adminStatusFilter === 'published' ? 'active' : ''}}" data-status="published" bindtap="switchAdminStatus">已发布</view>
  </view>

  <!-- 英雄分类选择器 -->
  <view class="hero-selector" wx:if="{{heroCategories.length > 0}}">
    <view class="selector-header" bindtap="toggleHeroSelector">
      <text class="selector-title">
        {{selectedHero === 'all' ? '全部英雄' : selectedHero}}
      </text>
      <text class="selector-count">({{total}})</text>
      <text class="selector-arrow {{showHeroSelector ? 'expanded' : ''}}">▼</text>
    </view>
    
    <!-- 英雄分类列表 -->
    <view class="hero-list {{showHeroSelector ? 'show' : ''}}" wx:if="{{showHeroSelector}}">
      <!-- 全部选项 -->
      <view class="hero-item {{selectedHero === 'all' ? 'selected' : ''}}" 
            bindtap="selectHero" data-hero="all">
        <text class="hero-name">全部英雄</text>
        <text class="hero-count">({{allUserPlans.length}})</text>
      </view>
      
      <!-- 英雄选项 -->
      <view class="hero-item {{selectedHero === item.heroName ? 'selected' : ''}}" 
            wx:for="{{heroCategories}}" wx:key="heroName"
            bindtap="selectHero" data-hero="{{item.heroName}}">
        <text class="hero-name">{{item.heroName}}</text>
        <text class="hero-count">({{item.count}})</text>
      </view>
    </view>
  </view>

  <!-- 方案列表 -->
  <view class="plans-list" wx:if="{{userPlans.length > 0}}">
    <view class="plan-item" wx:for="{{userPlans}}" wx:key="_id">
      <view class="plan-card" bindtap="viewPlan" data-plan="{{item}}">
        <!-- 方案信息 -->
        <view class="plan-info">
          <view class="plan-header">
            <text class="hero-name">{{item.heroName || '未知英雄'}}</text>
            <text class="plan-title">{{item.title || item.heroName + '方案'}}</text>
          </view>
          
          <!-- 状态和时间信息 -->
          <view class="plan-stats-row">
            <view class="status-badge {{item.status === 'published' ? 'published' : (item.status === 'pending' ? 'pending' : (item.status === 'rejected' ? 'rejected' : 'draft'))}}">
              <text class="status-icon">{{item.status === 'published' ? '✅' : (item.status === 'pending' ? '🔄' : (item.status === 'rejected' ? '⛔' : '📝'))}}</text>
              <text class="status-text">{{item.status === 'published' ? '已发布' : (item.status === 'pending' ? '审核中' : (item.status === 'rejected' ? '已拒绝' : '草稿'))}}</text>
            </view>
            <view class="meta-item time-item">
              <text class="meta-icon">🕒</text>
              <text class="meta-value">{{item.createTime}}</text>
            </view>
          </view>
        </view>
        
        <!-- 操作按钮 -->
        <view class="plan-actions">
          <view class="action-btn preview-btn" catchtap="viewPlan" data-plan="{{item}}">
            <text class="btn-text">预览</text>
          </view>
          <view class="action-btn edit-btn" catchtap="editPlan" data-plan="{{item}}">
            <text class="btn-text">编辑</text>
          </view>
          <view class="action-btn publish-btn" wx:if="{{item.status === 'draft' && isDevelopment}}" catchtap="publishPlan" data-plan="{{item}}">
            <text class="btn-text">发布</text>
          </view>
          <!-- 提交审核，仅草稿可见 -->
          <view class="action-btn publish-btn" wx:if="{{item.status === 'draft'}}" catchtap="submitReview" data-plan="{{item}}">
            <text class="btn-text">提交审核</text>
          </view>
          <!-- 提交审核，仅已拒绝可见 -->
          <view class="action-btn publish-btn" wx:if="{{item.status === 'rejected'}}" catchtap="submitReview" data-plan="{{item}}">
            <text class="btn-text">提交审核</text>
          </view>
          <!-- 管理员审核操作：仅管理员审核模式且审核中可见 -->
          <view class="action-btn publish-btn" wx:if="{{isAdminReview && item.status === 'pending'}}" catchtap="approvePlan" data-plan="{{item}}">
            <text class="btn-text">通过发布</text>
          </view>
          <view class="action-btn delete-btn" wx:if="{{isAdminReview && item.status === 'pending'}}" catchtap="rejectPlan" data-plan="{{item}}">
            <text class="btn-text">拒绝</text>
          </view>
          <view class="action-btn delete-btn" catchtap="deletePlan" data-plan="{{item}}">
            <text class="btn-text">删除</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && userPlans.length === 0}}">
    <image class="empty-icon" src="{{emptyIcon}}" mode="aspectFit" binderror="onImageError"></image>
    <text class="empty-text">还没有创建任何方案</text>
    <text class="empty-tip">开始创作你的第一个方案吧</text>
    <view class="empty-btn" bindtap="goToCreatePlan">
      <text class="btn-text">去创作方案</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore && !loading && userPlans.length > 0}}">
    <text class="load-more-text" bindtap="loadMore">上拉加载更多</text>
  </view>

  <!-- 没有更多 -->
  <view class="no-more" wx:if="{{!hasMore && userPlans.length > 0}}">
    <text class="no-more-text">没有更多了</text>
  </view>
</view> 