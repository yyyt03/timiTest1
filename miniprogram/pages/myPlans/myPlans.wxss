/* 我的方案页面样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 20rpx;
}

/* 页面标题 */
.page-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
  margin-bottom: 10rpx;
}

/* 管理员筛选栏样式 */

/* 管理筛选栏改为横向滚动，避免换行变形 */
.admin-filters {
  display: flex;
  flex-direction: row;
  gap: 12rpx; /* 减小间距 */
  margin: 10rpx 0 20rpx 0;
  overflow-x: auto;
  overflow-y: hidden;
  white-space: nowrap;
  padding: 8rpx 8rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.2);
  box-sizing: border-box;
  /* 添加弹性布局，让按钮能够自适应 */
  flex-wrap: nowrap;
}

.admin-filters .filter-btn {
  flex: 0 0 auto; /* 防止自动换行填充 */
  min-width: 110rpx; /* 进一步减小最小宽度 */
  max-width: 140rpx; /* 减小最大宽度限制 */
  text-align: center;
  padding: 10rpx 16rpx; /* 进一步减小内边距 */
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.85);
  color: #333;
  border: 1rpx solid rgba(255,255,255,0.6);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
  /* 添加文字溢出处理 */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx; /* 进一步减小字体大小 */
  /* 确保按钮内容居中 */
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 隐藏横向滚动条 */
.admin-filters::-webkit-scrollbar {
  display: none;
}

/* 添加滚动指示器 */
.admin-filters::after {
  content: '';
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 20rpx;
  background: linear-gradient(to right, transparent, rgba(255,255,255,0.2));
  pointer-events: none;
  z-index: 1;
}

.admin-filters .filter-btn.active {
  background: linear-gradient(135deg, #ffd43b 0%, #ffa94d 100%);
  color: #222;
  border-color: #ffc078;
  font-weight: 700;
}

/* 响应式优化：在不同屏幕尺寸下调整按钮尺寸 */
@media screen and (max-width: 375px) {
  .admin-filters .filter-btn {
    min-width: 90rpx;
    padding: 8rpx 12rpx;
    font-size: 20rpx;
  }
  
  .admin-filters {
    gap: 6rpx;
  }
}

@media screen and (max-width: 320px) {
  .admin-filters .filter-btn {
    min-width: 80rpx;
    padding: 6rpx 10rpx;
    font-size: 18rpx;
  }
  
  .admin-filters {
    gap: 4rpx;
  }
}

/* 确保状态筛选器容器有正确的定位 */
.admin-filters {
  position: relative;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  margin-right: 10rpx;
}

.plan-count {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 英雄分类选择器 横向样式 */
.hero-selector {
  margin: 0 24rpx 24rpx 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  border: 1rpx solid #f0f0f0;
  width: calc(100% - 48rpx);
  box-sizing: border-box;
  max-width: 100%; /* 确保不超过容器宽度 */
  transition: all 0.3s ease;
}

.hero-selector:hover {
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  transform: translateY(-2rpx);
}

/* 头部选择器样式，始终占满一行 */
.selector-header {
  display: flex;
  align-items: center;
  justify-content: center; /* 默认居中 */
  width: 100%;
  min-height: 88rpx; /* 增大高度 */
  padding: 0rpx 24rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  border-bottom: 1rpx solid #f0f0f0;
  cursor: pointer;
  transition: all 0.3s ease;
  box-sizing: border-box;
  position: relative;
}

.selector-header:active {
  background: linear-gradient(135deg, #f0f2f5 0%, #f8f9fa 100%);
  transform: scale(0.98);
}

.selector-header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 0;
  height: 3rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  transition: width 0.3s ease;
  transform: translateX(-50%);
}

.hero-selector:hover .selector-header::after {
  width: 60%;
}

.selector-title {
  font-size: 30rpx; /* 增大字体 */
  font-weight: 600;
  color: #2d3748;
  flex: 1;
  text-align: center; /* 默认居中 */
  letter-spacing: 0.5rpx;
}

.selector-count {
  font-size: 24rpx; /* 增大字体 */
  color: #667eea;
  margin-left: 16rpx;
  font-weight: 500;
  background: rgba(102, 126, 234, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.selector-arrow {
  font-size: 20rpx; /* 增大字体 */
  color: #667eea;
  transition: all 0.3s ease;
  margin-left: 20rpx;
  opacity: 0.8;
}

.selector-arrow.expanded {
  transform: rotate(180deg);
  opacity: 1;
  color: #764ba2;
}

/* 英雄列表网格布局 */
.hero-list {
  display: grid;
  grid-template-columns: repeat(6, 1fr); /* 固定每行6个英雄 */
  gap: 12rpx; /* 减小间距，让6个英雄能更好地适应 */
  padding: 16rpx; /* 减小内边距 */
  background: #fff;
  box-sizing: border-box;
  max-width: 100%;
  overflow: hidden;
  opacity: 0;
  transform: translateY(-20rpx);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  width: 100%;
}

.hero-list.show {
  opacity: 1;
  transform: translateY(0);
}

/* 英雄项样式 */
.hero-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 4rpx; /* 减小内边距 */
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
  box-sizing: border-box;
  background: transparent;
  border: none;
  position: relative;
  min-width: 80rpx; /* 减小最小宽度 */
  max-width: 100rpx; /* 减小最大宽度 */
  overflow: hidden;
}

.hero-item.selected {
  background: transparent;
  color: #667eea;
  border: none;
}

.hero-item:not(.selected):hover {
  transform: translateY(-4rpx);
}

.hero-item:not(.selected):active {
  background: transparent;
  transform: scale(0.95) translateY(-2rpx);
}

/* 英雄头像样式 */
.hero-avatar {
  width: 60rpx; /* 减小头像尺寸 */
  height: 60rpx;
  border-radius: 50%;
  background: #667eea;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 6rpx; /* 减小底部间距 */
  border: 2rpx solid #ffffff; /* 减小边框 */
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.25); /* 减小阴影 */
  overflow: hidden;
  position: relative;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  flex-shrink: 0;
}

.hero-item:hover .hero-avatar {
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.35);
  transform: scale(1.05);
}

.all-hero-avatar {
  background: #10b981;
}

.hero-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
}

.hero-item.selected .hero-avatar {
  background: #ffffff;
  border-color: #ffffff;
}

.hero-item .hero-name {
  font-size: 20rpx; /* 减小字体大小 */
  font-weight: 500;
  color: #4a5568;
  text-align: center;
  line-height: 1.2;
  margin-bottom: 0;
  transition: all 0.3s ease;
  word-break: break-all;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-item:hover .hero-name {
  color: #667eea;
  font-weight: 600;
}

.hero-item.selected .hero-name {
  color: #667eea;
  font-weight: 600;
}

/* 确保英雄筛选器容器不会超出边界 */
.hero-selector {
  margin: 0 24rpx 24rpx 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  border: 1rpx solid #f0f0f0;
  width: calc(100% - 48rpx);
  box-sizing: border-box;
  max-width: 100%;
  transition: all 0.3s ease;
}

/* 响应式设计：小屏幕设备 */
@media screen and (max-width: 750rpx) {
  .hero-selector {
    margin: 0 12rpx 12rpx 12rpx;
    width: calc(100% - 24rpx);
    border-radius: 16rpx;
  }
  
  .selector-header {
    min-height: 72rpx;
    padding: 0rpx 16rpx;
  }
  
  .selector-title {
    font-size: 26rpx;
  }
  
  .selector-count {
    font-size: 20rpx;
    padding: 2rpx 8rpx;
    margin-left: 12rpx;
  }
  
  .selector-arrow {
    font-size: 18rpx;
    margin-left: 16rpx;
  }
  
  .hero-list {
    grid-template-columns: repeat(6, 1fr); /* 小屏幕下仍然保持6个 */
    gap: 8rpx; /* 进一步减小间距 */
    padding: 12rpx; /* 减小内边距 */
    overflow: hidden;
  }
  
  .hero-item {
    padding: 6rpx 2rpx; /* 减小内边距 */
  }
  
  .hero-avatar {
    width: 50rpx; /* 减小头像尺寸 */
    height: 50rpx;
    margin-bottom: 4rpx; /* 减小底部间距 */
    border: 2rpx solid #ffffff;
  }
  
  .hero-item .hero-name {
    font-size: 16rpx; /* 减小字体大小 */
    margin-bottom: 0;
  }
}

/* 响应式设计：超小屏幕设备 */
@media screen and (max-width: 600rpx) {
  .hero-selector {
    margin: 0 8rpx 8rpx 8rpx;
    width: calc(100% - 16rpx);
  }
  
  .hero-list {
    grid-template-columns: repeat(6, 1fr); /* 超小屏幕下仍然保持6个 */
    gap: 6rpx; /* 进一步减小间距 */
    padding: 10rpx; /* 减小内边距 */
  }
  
  .hero-avatar {
    width: 45rpx; /* 进一步减小头像尺寸 */
    height: 45rpx;
  }
  
  .hero-item .hero-name {
    font-size: 14rpx; /* 进一步减小字体大小 */
  }
}

/* 中等屏幕优化 */
@media screen and (min-width: 751rpx) and (max-width: 900rpx) {
  .hero-list {
    grid-template-columns: repeat(6, 1fr); /* 中等屏幕下保持6个 */
    gap: 14rpx; /* 适当增加间距 */
    padding: 18rpx; /* 适当增加内边距 */
  }
  
  .hero-avatar {
    width: 65rpx; /* 适当增加头像尺寸 */
    height: 65rpx;
  }
}

/* 大屏幕优化 */
@media screen and (min-width: 901rpx) {
  .hero-list {
    grid-template-columns: repeat(6, 1fr); /* 大屏幕下保持6个 */
    gap: 16rpx; /* 适当增加间距 */
    padding: 20rpx; /* 适当增加内边距 */
  }
  
  .hero-avatar {
    width: 70rpx; /* 适当增加头像尺寸 */
    height: 70rpx;
  }
}

/* 确保内容不会超出容器边界 */
.hero-selector {
  max-width: 100vw;
  overflow: hidden;
}

.hero-list {
  max-width: 100%;
  overflow: hidden;
}

.hero-item {
  max-width: 100%;
  overflow: hidden;
}

.hero-avatar {
  max-width: 100%;
  overflow: hidden;
}

.hero-avatar-img {
  max-width: 100%;
  max-height: 100%;
}

/* 方案列表 */
.plans-list {
  width: 100%;
}

.plan-item {
  margin-bottom: 30rpx;
}

.plan-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(10rpx);
  transition: all 0.3s ease;
}

.plan-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

/* 方案信息 */
.plan-info {
  margin-bottom: 20rpx;
}

.plan-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.hero-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-right: 20rpx;
}

.plan-title {
  font-size: 28rpx;
  color: #666666;
  flex: 1;
}

.plan-stats-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.status-badge {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-badge.published {
  background: linear-gradient(135deg, #e8f5e8 0%, #d4edda 100%);
  border: 1rpx solid #c3e6cb;
  color: #155724;
}

.status-badge.draft {
  background: linear-gradient(135deg, #fff7e6 0%, #ffeaa7 100%);
  border: 1rpx solid #ffd43b;
  color: #856404;
}

.status-badge.pending {
  background: linear-gradient(135deg, #e6f0ff 0%, #d0ebff 100%);
  border: 1rpx solid #74c0fc;
  color: #1c7ed6;
}

.status-badge.rejected {
  background: linear-gradient(135deg, #fff7e6 0%, #ffeaa7 100%);
  border: 1rpx solid #ffd43b;
  color: #856404;
}

.status-badge.offline {
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border: 1rpx solid #6c757d;
  color: #495057;
}

.status-icon {
  font-size: 20rpx;
  margin-right: 6rpx;
}

.status-text {
  font-size: 22rpx;
  font-weight: 500;
}

/* 返回原因标签样式 */
.rejection-reason {
  display: flex;
  align-items: flex-start;
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: linear-gradient(135deg, #fff7e6 0%, #ffeaa7 100%);
  border: 1rpx solid #ffd43b;
  border-radius: 12rpx;
  gap: 8rpx;
}

.reason-label {
  font-size: 22rpx;
  color: #856404;
  font-weight: 600;
  flex-shrink: 0;
}

.reason-text {
  font-size: 22rpx;
  color: #856404;
  line-height: 1.4;
  word-break: break-all;
}

.stat-badge {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border: 1rpx solid #dee2e6;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.like-badge {
  background: linear-gradient(135deg, #fff5f5 0%, #ffe3e3 100%);
  border-color: #ffc9c9;
}

.favorite-badge {
  background: linear-gradient(135deg, #fff9db 0%, #fff3bf 100%);
  border-color: #ffec99;
}

.stat-icon {
  font-size: 20rpx;
  margin-right: 6rpx;
}

.stat-value {
  font-size: 24rpx;
  color: #333333;
  font-weight: 600;
}

.meta-item {
  display: flex;
  align-items: center;
  padding: 8rpx 12rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  border: 1rpx solid #e9ecef;
}

.time-item {
  background: linear-gradient(135deg, #f3e5f5 0%, #e1bee7 100%);
  border-color: #ce93d8;
}

.meta-icon {
  font-size: 20rpx;
  margin-right: 8rpx;
}

.meta-value {
  font-size: 22rpx;
  color: #333333;
  font-weight: 500;
}

/* 操作按钮 */
.plan-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.action-btn {
  flex: 1;
  padding: 20rpx 16rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
}

.action-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.5s ease;
}

.action-btn:active::before {
  left: 100%;
}

.preview-btn {
  background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
  color: #ffffff;
  border: 2rpx solid #0056b3;
  box-shadow: 0 2rpx 8rpx rgba(0, 123, 255, 0.3);
}

.preview-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 1rpx 4rpx rgba(0, 123, 255, 0.4);
}

.edit-btn {
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  color: #495057;
  border: 2rpx solid #dee2e6;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.edit-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.12);
}

.publish-btn {
  background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
  color: #ffffff;
  border: 2rpx solid #1e7e34;
  box-shadow: 0 2rpx 8rpx rgba(40, 167, 69, 0.3);
}

.publish-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 1rpx 4rpx rgba(40, 167, 69, 0.4);
}

.delete-btn {
  background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
  color: #ffffff;
  border: 2rpx solid #bd2130;
  box-shadow: 0 2rpx 8rpx rgba(220, 53, 69, 0.3);
}

.delete-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 1rpx 4rpx rgba(220, 53, 69, 0.4);
}

.offline-btn {
  background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
  color: #ffffff;
  border: 2rpx solid #495057;
  box-shadow: 0 2rpx 8rpx rgba(108, 117, 125, 0.3);
}

.offline-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 1rpx 4rpx rgba(108, 117, 125, 0.4);
}

.republish-btn {
  background: linear-gradient(135deg, #17a2b8 0%, #138496 100%);
  color: #ffffff;
  border: 2rpx solid #138496;
  box-shadow: 0 2rpx 8rpx rgba(23, 162, 184, 0.3);
}

.republish-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 1rpx 4rpx rgba(23, 162, 184, 0.4);
}

.recommend-btn {
  background: linear-gradient(135deg, #ffc107 0%, #ff8f00 100%);
  color: #ffffff;
  border: 2rpx solid #ff8f00;
  box-shadow: 0 2rpx 8rpx rgba(255, 193, 7, 0.3);
}

.recommend-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 1rpx 4rpx rgba(255, 193, 7, 0.4);
}

.unrecommend-btn {
  background: linear-gradient(135deg, #6f42c1 0%, #5a32a3 100%);
  color: #ffffff;
  border: 2rpx solid #5a32a3;
  box-shadow: 0 2rpx 8rpx rgba(111, 66, 193, 0.3);
}

.unrecommend-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 1rpx 4rpx rgba(111, 66, 193, 0.4);
}

.btn-text {
  color: inherit;
  font-size: 26rpx;
  font-weight: 600;
  position: relative;
  z-index: 1;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 20rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 40rpx;
}

.empty-btn {
  background: linear-gradient(45deg, #667eea, #764ba2);
  padding: 20rpx 40rpx;
  border-radius: 50rpx;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.empty-btn:active {
  transform: scale(0.95);
}

.empty-btn .btn-text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top: 4rpx solid #ffffff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 40rpx 0;
}

.load-more-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: 40rpx 0;
}

.no-more-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
} 