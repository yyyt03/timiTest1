<view class="container">
  <!-- 英雄信息头部 -->
  <view class="hero-header">
    <view class="hero-info">
      <image class="hero-avatar" src="{{plan.heroAvatar}}" mode="aspectFit"></image>
      <view class="hero-details">
        <text class="hero-name">{{plan.heroName}}</text>
        <text class="plan-author">作者: {{plan.creatorName}}</text>
      </view>
    </view>
  </view>

  <!-- 技能、装备和玩法部分 -->
  <view class="skills-section" wx:if="{{plan.skillOne || plan.skillTwo || plan.skillThree}}">
    <view class="skills-container">
      <!-- 天赋加点小标题 -->
      <view class="section-title">
        <text class="title-text">天赋加点</text>
      </view>
      
      <!-- 一技能 -->
      <view class="skill-column" wx:if="{{plan.skillOne}}">
        <view class="skill-layout">
          <!-- 左侧：技能名称 -->
          <view class="skill-name-section">
            <text class="skill-name-text">一技能</text>
          </view>
          <!-- 右侧：核心技能和天赋 -->
          <view class="skill-content-section">
                         <!-- 核心技能 -->
             <view class="skill-core" wx:if="{{plan.skillOne.core}}">
               <view class="skill-info">
                 <text class="skill-name">{{plan.skillOne.core.name}}</text>
                 <text class="skill-desc">{{plan.skillOne.core.description}}</text>
               </view>
               <text class="skill-tag skill-tag-top">{{plan.skillOne.core.tag}}</text>
             </view>
             <!-- 天赋列表 -->
             <view class="skill-talents">
               <view class="talent-item" wx:for="{{plan.skillOne.talents}}" wx:key="index">
                 <view class="talent-info">
                   <text class="talent-name">{{item.name}}</text>
                   <text class="talent-desc">{{item.description}}</text>
                 </view>
                 <text class="talent-tag talent-tag-top">{{item.tag}}</text>
               </view>
             </view>
          </view>
        </view>
      </view>

      <!-- 二技能 -->
      <view class="skill-column" wx:if="{{plan.skillTwo}}">
        <view class="skill-layout">
          <!-- 左侧：技能名称 -->
          <view class="skill-name-section">
            <text class="skill-name-text">二技能</text>
          </view>
          <!-- 右侧：核心技能和天赋 -->
          <view class="skill-content-section">
                         <!-- 核心技能 -->
             <view class="skill-core" wx:if="{{plan.skillTwo.core}}">
               <view class="skill-info">
                 <text class="skill-name">{{plan.skillTwo.core.name}}</text>
                 <text class="skill-desc">{{plan.skillTwo.core.description}}</text>
               </view>
               <text class="skill-tag skill-tag-top">{{plan.skillTwo.core.tag}}</text>
             </view>
             <!-- 天赋列表 -->
             <view class="skill-talents">
               <view class="talent-item" wx:for="{{plan.skillTwo.talents}}" wx:key="index">
                 <view class="talent-info">
                   <text class="talent-name">{{item.name}}</text>
                   <text class="talent-desc">{{item.description}}</text>
                 </view>
                 <text class="talent-tag talent-tag-top">{{item.tag}}</text>
               </view>
             </view>
          </view>
        </view>
      </view>

      <!-- 三技能 -->
      <view class="skill-column" wx:if="{{plan.skillThree}}">
        <view class="skill-layout">
          <!-- 左侧：技能名称 -->
          <view class="skill-name-section">
            <text class="skill-name-text">三技能</text>
          </view>
          <!-- 右侧：核心技能和天赋 -->
          <view class="skill-content-section">
                         <!-- 核心技能 -->
             <view class="skill-core" wx:if="{{plan.skillThree.core}}">
               <view class="skill-info">
                 <text class="skill-name">{{plan.skillThree.core.name}}</text>
                 <text class="skill-desc">{{plan.skillThree.core.description}}</text>
               </view>
               <text class="skill-tag skill-tag-top">{{plan.skillThree.core.tag}}</text>
             </view>
             <!-- 天赋列表 -->
             <view class="skill-talents">
               <view class="talent-item" wx:for="{{plan.skillThree.talents}}" wx:key="index">
                 <view class="talent-info">
                   <text class="talent-name">{{item.name}}</text>
                   <text class="talent-desc">{{item.description}}</text>
                 </view>
                 <text class="talent-tag talent-tag-top">{{item.tag}}</text>
               </view>
             </view>
          </view>
        </view>
      </view>

      <!-- 装备部分 -->
      <view class="equipment-section" wx:if="{{plan.equipment}}">
        <view class="section-title">出装推荐</view>
        <view class="equipment-grid">
          <view class="equipment-item" wx:for="{{plan.equipment}}" wx:key="index">
            <image class="equipment-icon" src="{{item.imageUrl}}" mode="aspectFit" wx:if="{{item.imageUrl}}"></image>
            <text class="equipment-name">{{item.name}}</text>
          </view>
        </view>
      </view>

      <!-- 玩法说明 -->
      <view class="strategy-section" wx:if="{{plan.description}}">
        <view class="section-title">玩法说明</view>
        <view class="strategy-content">
          <text class="strategy-text">{{plan.description}}</text>
        </view>
      </view>

      <!-- 底部信息 -->
      <view class="footer">
        <text class="footer-text">微信小程序-觉醒天赋推荐</text>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-buttons">
    <button class="share-btn" bindtap="sharePlan">
      <text class="btn-text">分享方案</text>
    </button>
    <button class="favorite-btn {{plan.isFavorited ? 'favorited' : ''}}" bindtap="toggleFavorite">
      <text class="btn-text">{{plan.isFavorited ? '取消收藏' : '收藏方案'}}</text>
    </button>
  </view>
</view> 