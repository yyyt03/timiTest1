.container {
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 英雄信息头部 */
.hero-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 20rpx 30rpx;
  margin: 0 30rpx 20rpx 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.3);
  border-radius: 20rpx;
  position: relative;
  overflow: hidden;
}

.hero-info {
  display: flex;
  align-items: center;
}

.hero-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  margin-right: 20rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.hero-details {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.hero-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 6rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.plan-author {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

/* 方案描述 */
.plan-description {
  background: #ffffff;
  padding: 30rpx;
  margin: 0 30rpx 20rpx 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.description-header {
  margin-bottom: 15rpx;
}

.description-label {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 15rpx;
  padding-left: 15rpx;
  border-left: 4rpx solid #667eea;
  display: block;
  line-height: 1.2;
}

.description-text {
  font-size: 28rpx;
  color: #34495e;
  line-height: 1.6;
  padding: 15rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-radius: 12rpx;
  border: 1rpx solid #e9ecef;
  display: block;
  word-wrap: break-word;
  white-space: normal;
}

/* 技能部分 - 纵向布局 */
.skills-section {
  background: #ffffff;
  margin: 0 30rpx 20rpx 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  border-radius: 20rpx;
  padding: 20rpx 0;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.skills-container {
  display: flex;
  flex-direction: column;
  padding: 0 30rpx;
  gap: 6rpx;
}

.skill-column {
  width: 100%;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-radius: 16rpx;
  border: 1rpx solid #e9ecef;
  padding: 12rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.skill-layout {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
  height: 100%;
}

.skill-name-section {
  width: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 12rpx;
  border: none;
  padding: 10rpx 6rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.skill-name-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
  text-align: center;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
}

.skill-content-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.skill-core {
  display: flex;
  align-items: flex-start;
  padding: 8rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 12rpx;
  border: 2rpx solid #667eea;
  margin-bottom: 4rpx;
  position: relative;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.1);
}

.skill-talents {
  display: flex;
  flex-direction: column;
  gap: 3rpx;
}

.talent-item {
  display: flex;
  align-items: flex-start;
  padding: 6rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  border-radius: 10rpx;
  border: 1rpx solid #e9ecef;
  position: relative;
  transition: all 0.2s ease;
}



.skill-info, .talent-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.skill-name, .talent-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.skill-tag, .talent-tag {
  font-size: 14rpx;
  color: #667eea;
  background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
  padding: 3rpx 6rpx;
  border-radius: 6rpx;
  align-self: flex-start;
  margin-bottom: 3rpx;
  font-weight: 600;
}

.skill-tag-top, .talent-tag-top {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  font-size: 12rpx;
  color: #667eea;
  background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
  padding: 3rpx 6rpx;
  border-radius: 4rpx;
  z-index: 1;
  font-weight: 600;
  max-width: 80rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.skill-desc, .talent-desc {
  font-size: 22rpx;
  color: #34495e;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-all;
}

/* 装备出装 */
.equipment-section {
  background: #ffffff;
  padding: 30rpx;
  margin: 0 30rpx 20rpx 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 25rpx;
  padding-left: 15rpx;
  border-left: 4rpx solid #667eea;
}

.equipment-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  padding: 0;
  justify-content: space-between;
}

.equipment-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 8rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-radius: 16rpx;
  border: 1rpx solid #e9ecef;
  transition: all 0.3s ease;
  min-height: 100rpx;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.equipment-item:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  border-color: #667eea;
}

.equipment-icon {
  width: 50rpx;
  height: 50rpx;
  border-radius: 25rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border: 2rpx solid #667eea;
  margin-bottom: 8rpx;
  box-shadow: 0 3rpx 12rpx rgba(102, 126, 234, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.equipment-icon-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
}

.equipment-name {
  font-size: 18rpx;
  color: #34495e;
  text-align: center;
  line-height: 1.2;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
  padding: 0 4rpx;
}



/* 操作按钮 */
.action-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 25rpx 40rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.15);
  gap: 25rpx;
  border-top: 1rpx solid rgba(102, 126, 234, 0.1);
  backdrop-filter: blur(10rpx);
  z-index: 1000;
}

.share-btn, .favorite-btn {
  flex: 1;
  height: 90rpx;
  border-radius: 45rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  font-weight: 600;
  font-size: 30rpx;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.share-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
}

.share-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.favorite-btn {
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  color: #34495e;
  border: 2rpx solid #e9ecef;
}

.favorite-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.favorite-btn.favorited {
  background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
  color: #ffffff;
  border: none;
}

.favorite-btn.favorited:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(231, 76, 60, 0.3);
}

.btn-text {
  font-size: 30rpx;
  font-weight: 600;
} 