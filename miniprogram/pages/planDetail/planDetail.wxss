.container {
  background-color: #ffffff;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 英雄信息头部 */
.hero-header {
  background-color: #ffffff;
  padding: 30rpx 40rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
  border-bottom: 1rpx solid #f0f0f0;
}

.hero-info {
  display: flex;
  align-items: center;
}

.hero-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  margin-right: 30rpx;
  border: 3rpx solid #f0f0f0;
}

.hero-details {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.hero-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.plan-author {
  font-size: 26rpx;
  color: #666666;
  font-weight: 400;
}

/* 方案描述 */
.plan-description {
  background-color: #ffffff;
  padding: 30rpx 40rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
  border-bottom: 1rpx solid #f0f0f0;
}

.description-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.5;
}

/* 技能部分 - 横向布局 */
.skills-section {
  background-color: #ffffff;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
  padding: 20rpx 0;
}

.skills-container {
  display: flex;
  justify-content: space-between;
  padding: 0 15rpx;
  gap: 10rpx;
}

.skill-column {
  flex: 1;
  max-width: calc(33.33% - 7rpx);
  background-color: #f8f9fa;
  border-radius: 10rpx;
  border: 1rpx solid #e9ecef;
  padding: 12rpx;
  display: flex;
  flex-direction: column;
  min-height: 400rpx;
}

.skill-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 10rpx;
  text-align: center;
  padding: 6rpx 0;
  background-color: #ffffff;
  border-radius: 6rpx;
  border: 1rpx solid #e0e0e0;
}

.skill-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.skill-core {
  display: flex;
  align-items: flex-start;
  padding: 8rpx;
  background-color: #ffffff;
  border-radius: 6rpx;
  border: 1rpx solid #e0e0e0;
  margin-bottom: 6rpx;
  position: relative;
}

.skill-talents {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.talent-item {
  display: flex;
  align-items: flex-start;
  padding: 6rpx;
  background-color: #ffffff;
  border-radius: 4rpx;
  border: 1rpx solid #e0e0e0;
  position: relative;
}

.skill-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 14rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.skill-icon-core {
  background-color: #333333;
  border: 2rpx solid #000000;
}

.skill-icon-talent {
  background-color: #666666;
  border: 2rpx solid #333333;
}

.skill-info, .talent-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.skill-name, .talent-name {
  font-size: 18rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.skill-tag, .talent-tag {
  font-size: 14rpx;
  color: #333333;
  background-color: #f0f0f0;
  padding: 1rpx 3rpx;
  border-radius: 6rpx;
  align-self: flex-start;
  margin-bottom: 2rpx;
}

.skill-tag-top, .talent-tag-top {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  font-size: 12rpx;
  color: #333333;
  background-color: #f0f0f0;
  padding: 1rpx 4rpx;
  border-radius: 4rpx;
  z-index: 1;
}

.skill-desc, .talent-desc {
  font-size: 16rpx;
  color: #666666;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-all;
}

/* 装备出装 */
.equipment-section {
  background-color: #ffffff;
  padding: 30rpx 40rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 15rpx;
  padding-left: 15rpx;
  border-left: 4rpx solid #000000;
}

.equipment-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.equipment-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100rpx;
}

.equipment-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background-color: #f0f0f0;
  border: 2rpx solid #e0e0e0;
  margin-bottom: 8rpx;
}

.equipment-name {
  font-size: 20rpx;
  color: #666666;
  text-align: center;
  line-height: 1.2;
}

/* 召唤师技能 */
.summoner-section {
  background-color: #ffffff;
  padding: 30rpx 40rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
  border-bottom: 1rpx solid #f0f0f0;
}

.summoner-skill {
  display: flex;
  align-items: center;
  padding: 15rpx;
  background-color: #f8f9fa;
  border-radius: 8rpx;
  border: 1rpx solid #e9ecef;
}

.summoner-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background-color: #666666;
  border: 2rpx solid #333333;
  margin-right: 15rpx;
}

.summoner-name {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

/* 操作按钮 */
.action-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 40rpx;
  background-color: #ffffff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.08);
  gap: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.share-btn, .favorite-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  font-weight: 500;
}

.share-btn {
  background-color: #333333;
  color: #ffffff;
}

.favorite-btn {
  background-color: #f8f9fa;
  color: #333333;
  border: 2rpx solid #e0e0e0;
}

.favorite-btn.favorited {
  background-color: #333333;
  color: #ffffff;
  border: none;
}

.btn-text {
  font-size: 28rpx;
  font-weight: 500;
}

.points-text {
  position: absolute;
  top: -8rpx;
  right: 15rpx;
  font-size: 18rpx;
  background-color: #666666;
  color: #ffffff;
  padding: 2rpx 6rpx;
  border-radius: 8rpx;
} 