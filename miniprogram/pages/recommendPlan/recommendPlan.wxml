<view class="container">
  <!-- 顶部筛选选项 -->
  <view class="filter-section">
    <view class="filter-tabs">
      <view class="filter-tab {{currentFilter === 'featured' ? 'active' : ''}}" bindtap="switchFilter" data-type="featured">
        精选方案
      </view>
      <view class="filter-tab {{currentFilter === 'latest' ? 'active' : ''}}" bindtap="switchFilter" data-type="latest">
        最新方案
      </view>
    </view>
  </view>

  <!-- 英雄筛选器 -->
  <view class="hero-filter-section">
    <view class="hero-filter-header" bindtap="toggleHeroFilter">
      <view class="hero-filter-display">
        <image class="hero-filter-avatar" src="{{selectedHeroInfo.avatar}}" mode="aspectFit"></image>
        <text class="hero-filter-text">{{selectedHeroInfo.name}}</text>
      </view>
      <view class="hero-filter-arrow {{showHeroFilter ? 'up' : 'down'}}">▼</view>
    </view>
    
    <!-- 英雄下拉列表 -->
    <view class="hero-dropdown {{showHeroFilter ? 'show' : ''}}" wx:if="{{showHeroFilter}}">
      <view class="hero-dropdown-item {{selectedHero === 'all' ? 'active' : ''}}" 
            bindtap="filterByHero" data-hero="all">
        <image class="hero-dropdown-avatar" src="/images_backup/heroes/mingshiyin.jpg" mode="aspectFit"></image>
        <text>全部英雄</text>
      </view>
      <view class="hero-dropdown-item {{selectedHero === item.heroId ? 'active' : ''}}" 
            wx:for="{{heroList}}" wx:key="heroId" 
            bindtap="filterByHero" data-hero="{{item.heroId}}">
        <image class="hero-dropdown-avatar" src="{{item.avatar}}" mode="aspectFit"></image>
        <text>{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 方案列表 -->
  <view class="plans-section">
    <!-- 加载中 -->
    <view class="loading-container" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <view class="loading-text">加载中...</view>
    </view>
    
    <!-- 方案列表 -->
    <view class="plans-grid" wx:else>
      <view class="plan-card" wx:for="{{recommendPlans}}" wx:key="_id" bindtap="viewPlan" data-plan="{{item}}">
        <!-- 方案头部 -->
        <view class="plan-header">
          <image class="plan-hero-avatar" src="{{item.heroAvatar}}" mode="aspectFit"></image>
          <view class="plan-info">
            <view class="plan-title">{{item.title}}</view>
            <view class="plan-hero-name">{{item.heroName}}</view>
          </view>
          <view class="plan-stats">
            <view class="stat-item">
              <image class="stat-icon" src="{{likeOutlineIcon}}" mode="aspectFit"></image>
              <text>{{item.likeCount}}</text>
            </view>
            <view class="stat-item">
              <image class="stat-icon" src="{{favoriteOutlineIcon}}" mode="aspectFit"></image>
              <text>{{item.favoriteCount}}</text>
            </view>
          </view>
        </view>
        
        <!-- 方案描述 -->
        <view class="plan-description">{{item.description}}</view>
        
        <!-- 方案标签 -->
        <view class="plan-tags">
          <view class="tag" wx:if="{{item.difficulty}}">{{item.difficulty}}</view>
          <view class="tag" wx:if="{{item.style}}">{{item.style}}</view>
          <view class="tag" wx:if="{{item.role}}">{{item.role}}</view>
        </view>
        
        <!-- 方案底部 -->
        <view class="plan-footer">
          <view class="plan-author">
            <image class="author-avatar" src="{{item.authorAvatar}}" mode="aspectFit"></image>
            <text>{{item.creatorName}}</text>
          </view>
          <view class="plan-time">{{item.createTime}}</view>
        </view>
      </view>
    </view>
    
    <!-- 无数据提示 -->
    <view class="no-data" wx:if="{{!loading && recommendPlans.length === 0}}">
      <image class="no-data-icon" src="{{emptyIcon}}" mode="aspectFit"></image>
      <view class="no-data-text">暂无推荐方案</view>
      <view class="no-data-tip">试试切换筛选条件</view>
    </view>
    
    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{loadingMore}}">
      <view class="loading-spinner"></view>
      <view class="loading-text">加载中...</view>
    </view>
    
    <!-- 没有更多数据 -->
    <view class="no-more" wx:if="{{!hasMore && recommendPlans.length > 0}}">
      <view class="no-more-text">没有更多数据了</view>
    </view>
  </view>
</view> 