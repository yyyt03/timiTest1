.container {
  background-color: #f5f7fa;
  min-height: 100vh;
}



/* 顶部筛选选项 */
.filter-section {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 24rpx 20rpx 20rpx;
  margin: 0 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.3);
  position: sticky;
  top: 20rpx;
  z-index: 100;
}

.filter-tabs {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  padding: 0 30rpx 20rpx;
}

.filter-tab {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.8);
  padding: 16rpx 32rpx;
  border-radius: 28rpx;
  transition: all 0.3s ease;
  position: relative;
  font-weight: 500;
}

.filter-tab.active {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-weight: 600;
  backdrop-filter: blur(10rpx);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

/* 英雄筛选器 */
.hero-filter-section {
  background: #fff;
  margin-bottom: 20rpx;
  position: relative;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  border-radius: 0 0 16rpx 16rpx;
}

.hero-filter-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.hero-filter-header:active {
  background: rgba(102, 126, 234, 0.05);
}

.hero-filter-display {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hero-filter-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f0f0f0;
  border: 2rpx solid #e0e0e0;
}

.hero-filter-text {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.hero-filter-arrow {
  font-size: 26rpx;
  color: #667eea;
  transition: transform 0.3s ease;
  font-weight: bold;
}

.hero-filter-arrow.up {
  transform: rotate(180deg);
}

.hero-filter-arrow.down {
  transform: rotate(0deg);
}

/* 英雄下拉列表 */
.hero-dropdown {
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
  border-radius: 0 0 16rpx 16rpx;
}

.hero-dropdown.show {
  max-height: 600rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.hero-dropdown-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f8f9fa;
  transition: background-color 0.3s ease;
}

.hero-dropdown-item:last-child {
  border-bottom: none;
}

.hero-dropdown-item.active {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  border-left: 4rpx solid #667eea;
}

.hero-dropdown-item:active {
  background: rgba(102, 126, 234, 0.05);
}

.hero-dropdown-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #f0f0f0;
  border: 2rpx solid #e0e0e0;
}

.hero-dropdown-item text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.hero-dropdown-item.active text {
  color: #667eea;
  font-weight: 600;
}

/* 方案列表 */
.plans-section {
  padding: 20rpx 30rpx;
}

.plans-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.plan-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.plan-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.plan-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.plan-hero-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #f0f0f0;
}

.plan-info {
  flex: 1;
}

.plan-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
  line-height: 1.3;
}

.plan-hero-name {
  font-size: 24rpx;
  color: #666;
}

.plan-stats {
  display: flex;
  gap: 24rpx;
}

.plan-stats .stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #666;
  padding: 8rpx 12rpx;
  border-radius: 16rpx;
  transition: all 0.3s ease;
  background: rgba(102, 126, 234, 0.05);
}

.plan-stats .stat-item:active {
  background: rgba(102, 126, 234, 0.1);
  transform: scale(0.95);
}

.stat-icon {
  width: 32rpx;
  height: 32rpx;
}

.plan-description {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.plan-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 22rpx;
  color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
}

.plan-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.plan-author {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
}

.author-text {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.plan-time {
  font-size: 22rpx;
  color: #999;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #666;
}

/* 无数据状态 */
.no-data {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.no-data-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.no-data-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.no-data-tip {
  font-size: 24rpx;
  color: #999;
}

/* 加载更多 */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0;
  gap: 16rpx;
}

.load-more .loading-spinner {
  width: 32rpx;
  height: 32rpx;
  margin-bottom: 0;
}

.load-more .loading-text {
  font-size: 24rpx;
}

.no-more {
  text-align: center;
  padding: 30rpx 0;
}

.no-more-text {
  font-size: 24rpx;
  color: #999;
} 