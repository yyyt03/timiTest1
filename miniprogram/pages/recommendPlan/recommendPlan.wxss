.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx;
  box-sizing: border-box;
  background-color: #ffffff;
  min-height: 100vh;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 40rpx;
}

.coming-soon {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 200rpx;
  background-color: #f8f9fa;
  border-radius: 16rpx;
  padding: 60rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid #f0f0f0;
}

.coming-soon-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.coming-soon-icon-text {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background-color: #f8f9fa;
  color: #333333;
  font-size: 40rpx;
  font-weight: 600;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 30rpx;
  border: 3rpx solid #e9ecef;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.coming-soon-text {
  font-size: 32rpx;
  color: #666666;
  text-align: center;
  font-weight: 500;
} 