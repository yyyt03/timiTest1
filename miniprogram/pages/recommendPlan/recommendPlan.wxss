.container {
  background-color: #f5f7fa;
  min-height: 100vh;
  width: 100%;
  overflow-x: hidden; /* 防止横向滚动 */
  box-sizing: border-box;
}



/* 顶部筛选选项 */
.filter-section {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 0;
  margin: 0;
  border-radius: 0;
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.3);
  position: sticky;
  top: 0;
  z-index: 100;
  width: 100%; /* 改为100%而不是100vw */
  box-sizing: border-box;
}

.filter-tabs {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 0;
  padding: 16rpx 20rpx 16rpx 20rpx;
  width: 100%; /* 改为100%而不是100vw */
  min-height: 80rpx;
  position: relative;
  background: transparent;
  overflow: visible;
  box-sizing: border-box;
}

.filter-tab {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.85);
  padding: 18rpx 0;
  margin: 0 12rpx;
  border-radius: 40rpx;
  position: relative;
  font-weight: 500;
  background: transparent;
  border: none;
  cursor: pointer;
  z-index: 1;
  transition: color 0.25s cubic-bezier(0.4,0,0.2,1);
  overflow: visible;
}

.filter-tab.active {
  color: #f5f7fa;
  font-weight: 700;
  text-shadow: 0 2rpx 8rpx rgba(102,126,234,0.12);
}

.filter-tab::before {
  content: '';
  display: block;
  position: absolute;
  left: 50%;
  top: 50%;
  width: 0;
  height: 0;
  background: rgba(255,255,255,0.22);
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx 0 rgba(255,255,255,0.10), 0 1rpx 8rpx 0 rgba(102,126,234,0.08);
  opacity: 0;
  transform: translate(-50%, -50%) scale(0.7);
  transition:
    width 0.35s cubic-bezier(0.4,0,0.2,1),
    height 0.35s cubic-bezier(0.4,0,0.2,1),
    opacity 0.2s,
    transform 0.35s cubic-bezier(0.4,0,0.2,1);
  z-index: -1;
}

.filter-tab.active::before {
  width: 92%;
  height: 92%;
  opacity: 1;
  transform: translate(-50%, -50%) scale(1.08);
  background: rgba(255,255,255,0.32);
  box-shadow: 0 6rpx 24rpx 0 rgba(255,255,255,0.13), 0 2rpx 12rpx 0 rgba(102,126,234,0.08);
}

.filter-tab:active {
  color: #e0e7ff;
  background: transparent;
  transition: color 0.1s;
}

/* 英雄分类选择器 横向样式 */
.hero-selector {
  margin: 0 24rpx 24rpx 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  border: 1rpx solid #f0f0f0;
  width: calc(100% - 48rpx);
  box-sizing: border-box;
  max-width: 100%; /* 确保不超过容器宽度 */
  transition: all 0.3s ease;
}

.hero-selector:hover {
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  transform: translateY(-2rpx);
}

/* 头部选择器样式，始终占满一行 */
.selector-header {
  display: flex;
  align-items: center;
  justify-content: center; /* 默认居中 */
  width: 100%;
  min-height: 88rpx; /* 增大高度 */
  padding: 0rpx 24rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
  border-bottom: 1rpx solid #f0f0f0;
  cursor: pointer;
  transition: all 0.3s ease;
  box-sizing: border-box;
  position: relative;
}

.selector-header:active {
  background: linear-gradient(135deg, #f0f2f5 0%, #f8f9fa 100%);
  transform: scale(0.98);
}

.selector-header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 0;
  height: 3rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  transition: width 0.3s ease;
  transform: translateX(-50%);
}

.hero-selector:hover .selector-header::after {
  width: 60%;
}

.selector-title {
  font-size: 30rpx; /* 增大字体 */
  font-weight: 600;
  color: #2d3748;
  flex: 1;
  text-align: center; /* 默认居中 */
  letter-spacing: 0.5rpx;
}

.selector-count {
  font-size: 24rpx; /* 增大字体 */
  color: #667eea;
  margin-left: 16rpx;
  font-weight: 500;
  background: rgba(102, 126, 234, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.selector-arrow {
  font-size: 20rpx; /* 增大字体 */
  color: #667eea;
  transition: all 0.3s ease;
  margin-left: 20rpx;
  opacity: 0.8;
}

.selector-arrow.expanded {
  transform: rotate(180deg);
  opacity: 1;
  color: #764ba2;
}

/* 英雄列表网格布局 */
.hero-list {
  display: grid;
  grid-template-columns: repeat(6, 1fr); /* 一行6个 */
  gap: 20rpx;
  padding: 24rpx;
  background: #fff;
  box-sizing: border-box;
  max-width: 100%;
  overflow: hidden;
  opacity: 0;
  transform: translateY(-20rpx);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  width: 100%;
}

.hero-list.show {
  opacity: 1;
  transform: translateY(0);
}

/* 移除滚动条样式，因为不再需要滚动 */

/* 英雄项样式 */
.hero-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 8rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
  box-sizing: border-box;
  background: transparent;
  border: none;
  position: relative;
}

.hero-item.selected {
  background: transparent;
  color: #667eea;
  border: none;
}

.hero-item:not(.selected):hover {
  transform: translateY(-4rpx);
}

.hero-item:not(.selected):active {
  background: transparent;
  transform: scale(0.95) translateY(-2rpx);
}

/* 英雄头像样式 */
.hero-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #667eea;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  border: 3rpx solid #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.25);
  overflow: hidden;
  position: relative;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.hero-item:hover .hero-avatar {
  box-shadow: 0 8rpx 28rpx rgba(102, 126, 234, 0.35);
  transform: scale(1.05);
}

.all-hero-avatar {
  background: #10b981;
}

.hero-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
}

.hero-item.selected .hero-avatar {
  background: #ffffff;
  border-color: #ffffff;
}

.hero-item .hero-name {
  font-size: 24rpx;
  font-weight: 500;
  color: #4a5568;
  text-align: center;
  line-height: 1.2;
  margin-bottom: 0;
  transition: all 0.3s ease;
}

.hero-item:hover .hero-name {
  color: #667eea;
  font-weight: 600;
}

.hero-item.selected .hero-name {
  color: #667eea;
  font-weight: 600;
}

.hero-item .hero-count {
  display: none; /* 隐藏数量显示 */
}

/* 英雄下拉列表 */
.hero-dropdown {
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
  border-radius: 0 0 16rpx 16rpx;
}

.hero-dropdown.show {
  max-height: 600rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.hero-dropdown-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f8f9fa;
  transition: background-color 0.3s ease;
}

.hero-dropdown-item:last-child {
  border-bottom: none;
}

.hero-dropdown-item.active {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  border-left: 4rpx solid #667eea;
}

.hero-dropdown-item:active {
  background: rgba(102, 126, 234, 0.05);
}

.hero-dropdown-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #f0f0f0;
  border: 2rpx solid #e0e0e0;
}

.hero-dropdown-item text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.hero-dropdown-item.active text {
  color: #667eea;
  font-weight: 600;
}

/* 方案列表 */
.plans-section {
  padding: 20rpx 30rpx;
  width: 100%;
  box-sizing: border-box;
}

.plans-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.plan-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden; /* 防止内容溢出 */
}

.plan-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.plan-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.plan-hero-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #f0f0f0;
}

.plan-info {
  flex: 1;
  min-width: 0; /* 防止flex子项溢出 */
  max-width: calc(100% - 200rpx); /* 为头像和统计信息预留空间 */
}

.plan-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
  word-break: break-word; /* 允许长标题换行 */
}

.plan-hero-name {
  font-size: 24rpx;
  color: #666;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* 体验服标签 */
.beta-tag {
  color: #ff6b6b;
  background: rgba(255, 107, 107, 0.1);
  font-weight: 600;
}

.plan-stats {
  display: flex;
  gap: 16rpx;
  flex-shrink: 0; /* 防止被压缩 */
  min-width: 160rpx; /* 确保最小宽度 */
  max-width: 200rpx; /* 限制最大宽度 */
}

.plan-stats .stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #666;
  padding: 8rpx 12rpx;
  border-radius: 16rpx;
  transition: all 0.3s ease;
  background: rgba(102, 126, 234, 0.05);
  border: 2rpx solid rgba(102, 126, 234, 0.1);
  min-width: 70rpx; /* 确保最小宽度 */
  max-width: 90rpx; /* 限制最大宽度 */
  overflow: hidden; /* 防止内容溢出 */
}

.plan-stats .stat-item:active {
  background: rgba(102, 126, 234, 0.1);
  transform: scale(0.95);
  border-color: rgba(102, 126, 234, 0.2);
}

.stat-icon {
  width: 32rpx;
  height: 32rpx;
}

.stat-text {
  font-size: 24rpx;
  color: #666;
  min-width: 20rpx;
  text-align: center;
}

.plan-description {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-word; /* 允许长文本换行 */
  max-width: 100%;
}

.plan-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
  width: 100%;
  box-sizing: border-box;
}

.tag {
  font-size: 22rpx;
  color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  width: 100%;
  box-sizing: border-box;
}

.plan-author {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
  max-width: 60%; /* 限制作者信息宽度 */
  overflow: hidden;
}

.author-text {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-time {
  font-size: 22rpx;
  color: #999;
  max-width: 40%; /* 限制时间信息宽度 */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: right;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.plan-time::before {
  content: "🕒";
  font-size: 20rpx;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #666;
}

/* 无数据状态 */
.no-data {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.no-data-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.no-data-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.no-data-tip {
  font-size: 24rpx;
  color: #999;
}

/* 加载更多 */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0;
  gap: 16rpx;
}

.load-more .loading-spinner {
  width: 32rpx;
  height: 32rpx;
  margin-bottom: 0;
}

.load-more .loading-text {
  font-size: 24rpx;
}

.no-more {
  text-align: center;
  padding: 30rpx 0;
}

.no-more-text {
  font-size: 24rpx;
  color: #999;
} 

/* 响应式布局优化 */
@media screen and (max-width: 750rpx) {
  .container {
    padding: 0;
    margin: 0;
  }
  
  .filter-section {
    width: 100%;
    margin: 0;
    padding: 0;
  }
  
  .filter-tabs {
    width: 100%;
    padding: 16rpx 16rpx;
  }
  
  .hero-selector {
    margin: 0 12rpx 12rpx 12rpx;
    width: calc(100% - 24rpx);
    border-radius: 16rpx;
  }
  
  .selector-header {
    min-height: 72rpx;
    padding: 0rpx 16rpx;
  }
  
  .selector-title {
    font-size: 26rpx;
  }
  
  .selector-count {
    font-size: 20rpx;
    padding: 2rpx 8rpx;
    margin-left: 12rpx;
  }
  
  .selector-arrow {
    font-size: 18rpx;
    margin-left: 16rpx;
  }
  
  .hero-list {
    grid-template-columns: repeat(3, 1fr); /* 小屏幕下一行3个 */
    gap: 12rpx;
    padding: 16rpx;
    overflow: hidden;
  }
  
  .hero-item {
    padding: 8rpx 4rpx;
  }
  
  .hero-avatar {
    width: 56rpx;
    height: 56rpx;
    margin-bottom: 8rpx;
    border: 2rpx solid #ffffff;
  }
  
  .hero-item .hero-name {
    font-size: 18rpx;
    margin-bottom: 0;
  }
  
  .plans-section {
    padding: 12rpx 16rpx;
  }
  
  .plan-card {
    padding: 16rpx;
  }
  
  .plan-info {
    max-width: calc(100% - 160rpx);
  }
  
  .plan-stats {
    min-width: 120rpx;
    max-width: 160rpx;
  }
  
  .plan-stats .stat-item {
    min-width: 50rpx;
    max-width: 70rpx;
  }
}

/* 超小屏幕优化 */
@media screen and (max-width: 600rpx) {
  .hero-selector {
    margin: 0 8rpx 8rpx 8rpx;
    width: calc(100% - 16rpx);
  }
  
  .hero-list {
    grid-template-columns: repeat(2, 1fr); /* 超小屏幕下一行2个 */
    gap: 16rpx;
    padding: 20rpx;
  }
  
  .hero-avatar {
    width: 64rpx;
    height: 64rpx;
  }
  
  .hero-item .hero-name {
    font-size: 20rpx;
  }
}

/* 中等屏幕优化 */
@media screen and (min-width: 751rpx) and (max-width: 900rpx) {
  .hero-list {
    grid-template-columns: repeat(5, 1fr); /* 中等屏幕下一行5个 */
    gap: 18rpx;
    padding: 22rpx;
  }
  
  .hero-avatar {
    width: 72rpx;
    height: 72rpx;
  }
}

/* 大屏幕优化 */
@media screen and (min-width: 901rpx) {
  .hero-list {
    grid-template-columns: repeat(6, 1fr); /* 大屏幕下一行6个 */
    gap: 24rpx;
    padding: 28rpx;
  }
  
  .hero-avatar {
    width: 88rpx;
    height: 88rpx;
  }
}

/* 确保内容不会超出容器边界 */
.plan-card .plan-header,
.plan-card .plan-hero-avatar,
.plan-card .plan-info,
.plan-card .plan-title,
.plan-card .plan-hero-name,
.plan-card .plan-stats,
.plan-card .plan-description,
.plan-card .plan-tags,
.plan-card .plan-footer,
.plan-card .plan-author,
.plan-card .plan-time {
  max-width: 100%;
  box-sizing: border-box;
}

/* 英雄筛选器容器安全措施 */
.hero-selector {
  max-width: 100vw;
  overflow: hidden;
}

.hero-list {
  max-width: 100%;
  overflow: hidden;
}

.hero-item {
  max-width: 100%;
  overflow: hidden;
}

.hero-avatar {
  max-width: 100%;
  overflow: hidden;
}

.hero-avatar-img {
  max-width: 100%;
  max-height: 100%;
}

/* 优化长文本显示 */
.plan-title,
.plan-description,
.author-text,
.plan-time {
  word-wrap: break-word;
  overflow-wrap: break-word;
}

/* 防止flex布局溢出 */
.plan-header {
  flex-wrap: wrap;
  gap: 8rpx;
}

/* 确保标签不会超出卡片边界 */
.plan-tags {
  max-width: 100%;
}

.tag {
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
} 