.container {
  background-color: #f5f7fa;
  min-height: 100vh;
}

/* 精选方案展示 */
.featured-section {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 3rpx;
}

.featured-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.featured-card {
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  display: flex;
  transition: all 0.3s ease;
}

.featured-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.featured-hero-avatar {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(45deg, #f0f0f0, #e0e0e0);
}

.featured-content {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.featured-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.featured-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.featured-stats {
  display: flex;
  gap: 16rpx;
}

.featured-stats .stat-item {
  font-size: 22rpx;
  color: #888;
  background: rgba(255, 255, 255, 0.8);
  padding: 6rpx 12rpx;
  border-radius: 16rpx;
}

/* 顶部筛选选项 */
.filter-section {
  background: #fff;
  padding: 20rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  position: sticky;
  top: 0;
  z-index: 100;
}

.filter-tabs {
  display: flex;
  justify-content: space-around;
  padding: 0 30rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-tab {
  font-size: 28rpx;
  color: #666;
  padding: 16rpx 24rpx;
  border-radius: 24rpx;
  transition: all 0.3s ease;
}

.filter-tab.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-weight: 500;
}

/* 英雄筛选器 */
.hero-filter-section {
  background: #fff;
  margin-bottom: 20rpx;
  position: relative;
}

.hero-filter-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  cursor: pointer;
}

.hero-filter-display {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hero-filter-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.hero-filter-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.hero-filter-arrow {
  font-size: 24rpx;
  color: #999;
  transition: transform 0.3s ease;
}

.hero-filter-arrow.up {
  transform: rotate(180deg);
}

.hero-filter-arrow.down {
  transform: rotate(0deg);
}

/* 英雄下拉列表 */
.hero-dropdown {
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.hero-dropdown.show {
  max-height: 600rpx;
}

.hero-dropdown-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f8f9fa;
  transition: background-color 0.3s ease;
}

.hero-dropdown-item:last-child {
  border-bottom: none;
}

.hero-dropdown-item.active {
  background: rgba(102, 126, 234, 0.1);
}

.hero-dropdown-item:active {
  background: rgba(102, 126, 234, 0.05);
}

.hero-dropdown-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.hero-dropdown-item text {
  font-size: 28rpx;
  color: #333;
}

.hero-dropdown-item.active text {
  color: #667eea;
  font-weight: 500;
}

/* 方案列表 */
.plans-section {
  padding: 20rpx 30rpx;
}

.plans-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.plan-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.plan-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.plan-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.plan-hero-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #f0f0f0;
}

.plan-info {
  flex: 1;
}

.plan-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
  line-height: 1.3;
}

.plan-hero-name {
  font-size: 24rpx;
  color: #666;
}

.plan-stats {
  display: flex;
  gap: 16rpx;
}

.plan-stats .stat-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #888;
}

.stat-icon {
  width: 28rpx;
  height: 28rpx;
}

.plan-description {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.plan-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 22rpx;
  color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
}

.plan-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.plan-author {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.author-avatar {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.plan-time {
  font-size: 22rpx;
  color: #999;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #667eea;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #666;
}

/* 无数据状态 */
.no-data {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.no-data-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.no-data-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.no-data-tip {
  font-size: 24rpx;
  color: #999;
}

/* 加载更多 */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0;
  gap: 16rpx;
}

.load-more .loading-spinner {
  width: 32rpx;
  height: 32rpx;
  margin-bottom: 0;
}

.load-more .loading-text {
  font-size: 24rpx;
}

.no-more {
  text-align: center;
  padding: 30rpx 0;
}

.no-more-text {
  font-size: 24rpx;
  color: #999;
} 