<view class="container">
  <!-- 顶部展示区 -->
  <view class="header-section">
    <view class="welcome-text">
      <text class="main-title">攻略中心</text>
      <text class="sub-title">专业的王者荣耀天赋助手</text>
    </view>
  </view>
  
  <!-- 功能区 -->
  <view class="content-section">
    <view class="function-grid">
      <!-- 推荐方案 -->
      <view class="function-card" bindtap="goToRecommendPlan">
        <view class="card-icon recommend-icon">📚</view>
        <view class="card-content">
          <text class="card-title">推荐方案</text>
          <text class="card-desc">精选英雄攻略</text>
        </view>
        <view class="card-arrow">→</view>
      </view>
      
      <!-- 英雄分类 -->
      <view class="function-card" bindtap="goToHeroCategory">
        <view class="card-icon hero-icon">⚔️</view>
        <view class="card-content">
          <text class="card-title">英雄分类</text>
          <text class="card-desc">按分类浏览英雄</text>
        </view>
        <view class="card-arrow">→</view>
      </view>
      
      <!-- 体验服方案 -->
      <view class="function-card" bindtap="goToBetaPlan">
        <view class="card-icon beta-icon">🔬</view>
        <view class="card-content">
          <text class="card-title">体验服方案</text>
          <text class="card-desc">抢先体验新内容</text>
        </view>
        <view class="card-arrow">→</view>
      </view>
      
      <!-- 方案创作 -->
      <view class="function-card" bindtap="goToCreatePlan">
        <view class="card-icon create-icon">✏️</view>
        <view class="card-content">
          <text class="card-title">方案创作</text>
          <text class="card-desc">创建个性化方案</text>
        </view>
        <view class="card-arrow">→</view>
      </view>
    </view>
    
    <!-- 测试功能区域 -->
    <view class="test-section">
      <view class="test-card" bindtap="testGenerateImage">
        <view class="test-icon">🎨</view>
        <view class="test-content">
          <text class="test-title">一图流测试</text>
          <text class="test-desc">生成方案图片</text>
        </view>
        <view class="test-arrow">→</view>
      </view>
    </view>
  </view>
</view> 