<view class="container">
  <!-- 顶部展示区 -->
  <view class="header-section">
    <!-- 轮播图 -->
    <swiper class="header-swiper" indicator-dots="{{true}}" autoplay="{{true}}" interval="{{3000}}" duration="{{500}}">
      <!-- 第一页：文字展示 -->
      <swiper-item>
        <view class="text-slide">
          <view class="welcome-text">
            <text class="main-title">觉醒天赋推荐</text>
            <text class="sub-title">梦也许会流泪，但是永远不会倒下。</text>
          </view>
        </view>
      </swiper-item>
      
      <!-- 第二页：图片展示 -->
      <swiper-item>
        <image class="header-image" src="cloud://cloudbase-1gk9t6w2d1d090af.636c-cloudbase-1gk9t6w2d1d090af-1371508497/images/lunbo/lunbo2.jpg" mode="aspectFill"></image>
      </swiper-item>
    </swiper>
  </view>
  
  <!-- 功能区 -->
  <view class="content-section">
    <view class="function-grid">
      <!-- 推荐方案 -->
      <view class="function-card" bindtap="goToRecommendPlan">
        <view class="card-icon recommend-icon">📚</view>
        <view class="card-content">
          <text class="card-title">全部方案</text>
          <text class="card-desc">已有方案展示</text>
        </view>
        <view class="card-arrow">→</view>
      </view>
      
      <!-- 英雄分类 -->
      <view class="function-card" bindtap="goToHeroCategory">
        <view class="card-icon hero-icon">⚔️</view>
        <view class="card-content">
          <text class="card-title">英雄分类</text>
          <text class="card-desc">按分类浏览</text>
        </view>
        <view class="card-arrow">→</view>
      </view>
      
      <!-- 体验服方案 -->
      <view class="function-card" bindtap="goToBetaPlan">
        <view class="card-icon beta-icon">🔬</view>
        <view class="card-content">
          <text class="card-title">体验服方案</text>
          <text class="card-desc">体验er</text>
        </view>
        <view class="card-arrow">→</view>
      </view>
      
      <!-- 方案创作 -->
      <view class="function-card" bindtap="goToCreatePlan">
        <view class="card-icon create-icon">✏️</view>
        <view class="card-content">
          <text class="card-title">方案创作</text>
          <text class="card-desc">创建个性方案</text>
        </view>
        <view class="card-arrow">→</view>
      </view>
    </view>
  </view>
</view> 