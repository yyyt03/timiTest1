<view class="container">
  <!-- 顶部展示区 -->
  <view class="banner-container">
    <view class="banner-text">
      <text class="banner-title">觉醒天赋助手</text>
    </view>
  </view>
  
  <!-- 功能区 -->
  <view class="function-container">
    <view class="function-row">
      <!-- 推荐方案 -->
      <view class="function-card" bindtap="goToRecommendPlan">
        <image class="function-icon" src="{{iconUrls.recommendPlan}}" mode="aspectFit"></image>
        <text class="function-title">推荐方案</text>
      </view>
      
      <!-- 英雄分类 -->
      <view class="function-card" bindtap="goToHeroCategory">
        <image class="function-icon" src="{{iconUrls.heroCategory}}" mode="aspectFit"></image>
        <text class="function-title">英雄分类</text>
      </view>
    </view>
    
    <view class="function-row">
      <!-- 体验服方案 -->
      <view class="function-card" bindtap="goToBetaPlan">
        <image class="function-icon" src="{{iconUrls.betaPlan}}" mode="aspectFit"></image>
        <text class="function-title">体验服方案</text>
      </view>
      
      <!-- 方案创作 -->
      <view class="function-card" bindtap="goToCreatePlan">
        <image class="function-icon" src="{{iconUrls.createPlan}}" mode="aspectFit"></image>
        <text class="function-title">方案创作</text>
      </view>
    </view>
  </view>
</view> 