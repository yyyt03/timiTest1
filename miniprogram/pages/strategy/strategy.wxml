<view class="container">
  <!-- 顶部展示区 -->
  <view class="banner-container">
    <swiper class="banner" indicator-dots="{{true}}" autoplay="{{true}}" interval="{{3000}}" duration="{{500}}">
      <swiper-item>
        <image class="banner-image" src="../images/unused/轮播1.png" mode="aspectFill"></image>
      </swiper-item>
    </swiper>
  </view>
  
  <!-- 功能区 -->
  <view class="function-container">
    <view class="function-row">
      <!-- 推荐方案 -->
      <view class="function-card" bindtap="goToRecommendPlan">
        <image class="function-icon" src="../images/icons/recommend-plan.png" mode="aspectFit"></image>
        <text class="function-title">推荐方案</text>
      </view>
      
      <!-- 英雄分类 -->
      <view class="function-card" bindtap="goToHeroCategory">
        <image class="function-icon" src="../images/icons/hero-category.png" mode="aspectFit"></image>
        <text class="function-title">英雄分类</text>
      </view>
    </view>
    
    <view class="function-row">
      <!-- 体验服方案 -->
      <view class="function-card" bindtap="goToBetaPlan">
        <image class="function-icon" src="../images/icons/beta-plan.png" mode="aspectFit"></image>
        <text class="function-title">体验服方案</text>
      </view>
      
      <!-- 方案创作 -->
      <view class="function-card" bindtap="goToCreatePlan">
        <image class="function-icon" src="../images/icons/create-plan.png" mode="aspectFit"></image>
        <text class="function-title">方案创作</text>
      </view>
    </view>
  </view>
</view> 