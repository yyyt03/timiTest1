/* strategy.wxss */
.container {
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  min-height: 100vh;
  padding: 0;
}

/* 顶部展示区 */
.banner-container {
  width: 100%;
  height: 25vh;
  margin-bottom: 30rpx;
  overflow: hidden;
  position: relative;
}

.banner-text {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  color: white;
}

.banner-text::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(45deg, transparent 30%, rgba(255, 255, 255, 0.1) 50%, transparent 70%);
  animation: shimmer 3s infinite;
}

@keyframes shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

.banner-title {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
  z-index: 1;
  position: relative;
}

/* 功能区 */
.function-container {
  width: 100%;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.function-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
  width: 100%;
}

.function-card {
  width: 48%;
  height: 200rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid #f0f0f0;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.function-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #000000, #333333);
}

.function-card:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.function-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  background-color: #f8f9fa;
  padding: 15rpx;
  box-sizing: border-box;
}

.function-title {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
}

/* 测试卡片特殊样式 */
.test-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.test-card .function-title {
  color: white;
}

.test-card .function-icon {
  background-color: rgba(255, 255, 255, 0.1);
}

/* 占位卡片样式 */
.placeholder-card {
  background: transparent;
  box-shadow: none;
  border: none;
}

.placeholder-card::before {
  display: none;
}

.placeholder-content {
  width: 100%;
  height: 100%;
} 