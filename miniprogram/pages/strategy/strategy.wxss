/* 整体容器 */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0;
  box-sizing: border-box;
  background-color: #f5f5f5;
  height: 100vh;
}

/* 顶部展示区 */
.banner-container {
  width: 100%;
  height: 25vh;
  margin-bottom: 20rpx;
}

.banner {
  width: 100%;
  height: 100%;
}

.banner-text {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
  background-color: #4A90E2;
}

/* 功能区 */
.function-container {
  width: 100%;
  display: flex;
  flex-direction: column;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.function-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
  width: 100%;
}

.function-card {
  width: 48%;
  height: 200rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.function-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.function-icon-text {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #4A90E2;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: bold;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 20rpx;
}

.function-title {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
} 