/* 整体容器 */
.container {
  background-color: #1a1a2e;
  padding: 0;
  box-sizing: border-box;
  min-height: 100vh;
}

/* 顶部展示区 */
.banner-container {
  width: 100%;
  height: 25vh;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.banner {
  width: 100%;
  height: 100%;
}

.banner-image {
  width: 100%;
  height: 100%;
  border-radius: 0;
}

/* 功能区 */
.function-container {
  width: 100%;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.function-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
  width: 100%;
}

.function-card {
  width: 48%;
  height: 200rpx;
  background-color: #2c2c54;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  transition: all 0.3s ease;
}

.function-card:active {
  transform: scale(0.95);
}

.function-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.function-title {
  font-size: 28rpx;
  color: #e0e0e0;
  font-weight: 500;
} 