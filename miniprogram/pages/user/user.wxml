<view class="container">
  <!-- 用户信息卡片 -->
  <view class="content-section">
    <view class="user-card">
      <view class="user-info">
        <view class="avatar-container">
          <image wx:if="{{hasUserInfo}}" class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="avatar-placeholder">👤</view>
        </view>
        <view class="user-details">
          <text wx:if="{{hasUserInfo}}" class="nickname">{{userInfo.nickName}}</text>
          <text wx:else class="nickname">微信用户</text>
          <text class="user-status">王者荣耀天赋助手</text>
        </view>
        <view wx:if="{{!hasUserInfo}}" class="login-btn" bindtap="getUserInfo">
          <text class="login-text">登录</text>
        </view>
      </view>
    </view>
    
    <!-- 功能网格 -->
    <view class="function-grid">
      <!-- 我的方案 -->
      <view class="function-card" bindtap="goToMyPlans">
        <view class="card-icon my-plan-icon">📋</view>
        <view class="card-content">
          <text class="card-title">我的方案</text>
          <text class="card-desc" wx:if="{{userPlansCount > 0}}">{{userPlansCount}}个方案</text>
          <text class="card-desc" wx:else>暂无方案</text>
        </view>
        <view class="card-arrow">→</view>
      </view>
      
      <!-- 收藏方案 -->
      <view class="function-card" bindtap="goToFavorites">
        <view class="card-icon favorite-icon">❤️</view>
        <view class="card-content">
          <text class="card-title">收藏方案</text>
          <text class="card-desc">你的收藏在这</text>
        </view>
        <view class="card-arrow">→</view>
      </view>
      
      <!-- 创作方案 -->
      <view class="function-card" bindtap="goToCreatePlan">
        <view class="card-icon create-icon">✏️</view>
        <view class="card-content">
          <text class="card-title">方案创作</text>
          <text class="card-desc">创建个性方案</text>
        </view>
        <view class="card-arrow">→</view>
      </view>
      
      <!-- 占位卡片 -->
      <view class="function-card placeholder-card">
        <view class="placeholder-content"></view>
      </view>
    </view>
  </view>
  
  <!-- 联系信息 -->
  <view class="contact-info">
    <text class="contact-text">如有建议，敬请联系QQ：206789750</text>
  </view>
</view> 