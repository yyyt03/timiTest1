<view class="container">
  <!-- 用户信息卡片 -->
  <view class="content-section">
    <view class="user-card">
      <view class="user-info">
        <view class="avatar-container">
          <image wx:if="{{userInfo.avatarUrl}}" class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="avatar-placeholder">
            <text>👤</text>
          </view>
        </view>
        <view class="user-details">
          <text class="nickname">觉醒测试员</text>
        </view>
      </view>
    </view>
    
    <!-- 功能网格 -->
    <view class="function-grid">
      <!-- 我的方案 -->
      <view class="function-card" bindtap="goToMyPlans">
        <view class="card-icon my-plan-icon">📋</view>
        <view class="card-content">
          <text class="card-title">我的方案</text>
          <text class="card-desc">查看和管理方案</text>
        </view>
        <view class="card-arrow">→</view>
      </view>
      
      <!-- 收藏方案 -->
      <view class="function-card" bindtap="goToFavorites">
        <view class="card-icon favorite-icon">❤️</view>
        <view class="card-content">
          <text class="card-title">收藏方案</text>
          <text class="card-desc">你的收藏在这</text>
        </view>
        <view class="card-arrow">→</view>
      </view>
      
      <!-- 方案管理/审核（仅开发者可见） -->
      <view class="function-card" wx:if="{{isDevelopment}}" bindtap="goToPlanReview">
        <view class="card-icon hero-plan-icon">🛠️</view>
        <view class="card-content">
          <text class="card-title">方案管理/审核</text>
          <text class="card-desc">仅开发者可见，查看全部方案</text>
        </view>
        <view class="card-arrow">→</view>
      </view>

      <!-- 创作方案 -->
      <view class="function-card" bindtap="goToCreatePlan">
        <view class="card-icon create-icon">✏️</view>
        <view class="card-content">
          <text class="card-title">方案创作</text>
          <text class="card-desc">创建个性方案</text>
        </view>
        <view class="card-arrow">→</view>
      </view>
      
      <!-- 占位卡片 -->
      <view class="function-card placeholder-card">
        <view class="placeholder-content"></view>
      </view>
    </view>
  </view>
</view> 