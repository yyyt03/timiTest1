/* 整体容器 */
.container {
  background: linear-gradient(180deg, #f8fafc 0%, #e2e8f0 100%);
  min-height: 100vh;
  padding: 0;
  box-sizing: border-box;
}

/* 用户信息区域 */
.header-section {
  width: 100%;
  padding: 40rpx 30rpx 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  position: relative;
  overflow: hidden;
}

.header-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(45deg, transparent 30%, rgba(255, 255, 255, 0.1) 50%, transparent 70%);
  animation: shimmer 4s infinite;
}

@keyframes shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

.user-profile {
  display: flex;
  align-items: center;
  z-index: 1;
  position: relative;
}

.avatar-container {
  margin-right: 20rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.15);
}

.avatar-placeholder {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(10rpx);
}

.user-details {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 6rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.user-status {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 400;
}

.login-btn {
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 40rpx;
  backdrop-filter: blur(10rpx);
  transition: all 0.3s ease;
}

.login-btn:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

.login-text {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 500;
}

/* 内容区域 */
.content-section {
  padding: 20rpx 20rpx 40rpx;
  box-sizing: border-box;
}

.function-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.function-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 3rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.function-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, #667eea, #764ba2);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.function-card:active {
  transform: translateY(2rpx) scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
}

.function-card:active::before {
  opacity: 1;
}

.card-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 16rpx;
  background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.my-plan-icon {
  background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
}

.favorite-icon {
  background: linear-gradient(135deg, #fecaca 0%, #fca5a5 100%);
}

.create-icon {
  background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
}

.card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 4rpx;
}

.card-desc {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 400;
}

.card-arrow {
  font-size: 28rpx;
  color: #94a3b8;
  font-weight: 300;
  transition: all 0.3s ease;
}

.function-card:active .card-arrow {
  transform: translateX(4rpx);
  color: #667eea;
} 