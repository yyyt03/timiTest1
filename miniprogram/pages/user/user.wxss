/* 整体容器 */
.container {
  background-color: #ffffff;
  padding: 0;
  box-sizing: border-box;
  min-height: 100vh;
}

/* 用户信息区域 */
.user-info {
  width: 100%;
  height: 350rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin-bottom: 30rpx;
  position: relative;
  overflow: hidden;
}

.user-info::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(45deg, transparent 30%, rgba(255, 255, 255, 0.1) 50%, transparent 70%);
  animation: shimmer 3s infinite;
}

@keyframes shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

.banner-text {
  position: absolute;
  top: 30rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1;
}

.banner-title {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.avatar {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  z-index: 1;
  position: relative;
}

.nickname {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 600;
  z-index: 1;
  position: relative;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.login-btn {
  margin-top: 20rpx;
  padding: 16rpx 32rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50rpx;
  z-index: 1;
  position: relative;
  transition: all 0.3s ease;
}

.login-btn:active {
  background-color: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

.login-text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 500;
}

/* 功能卡片区域 */
.function-container {
  width: 100%;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.function-card {
  width: 100%;
  height: 120rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid #f0f0f0;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.function-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #000000, #333333);
}

.function-card:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.card-content {
  display: flex;
  align-items: center;
}

.card-icon {
  width: 50rpx;
  height: 50rpx;
  margin-right: 20rpx;
  border-radius: 8rpx;
  background-color: #f8f9fa;
  padding: 8rpx;
}

.card-title {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

.card-arrow {
  font-size: 36rpx;
  color: #999999;
} 