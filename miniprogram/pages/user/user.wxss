/* 整体容器 */
.container {
  background-color: #1a1a2e;
  padding: 0;
  box-sizing: border-box;
  min-height: 100vh;
}

/* 用户信息区域 */
.user-info {
  width: 100%;
  height: 350rpx;
  background: linear-gradient(to right, #8e2de2, #4a00e0);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin-bottom: 30rpx;
}

.avatar {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  margin-bottom: 20rpx;
}

.nickname {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 500;
  text-shadow: 1px 1px 2px rgba(0,0,0,0.3);
}

/* 功能卡片区域 */
.function-container {
  width: 100%;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.function-card {
  width: 100%;
  height: 120rpx;
  background-color: #2c2c54;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  transition: all 0.3s ease;
}

.function-card:active {
  transform: scale(0.98);
}

.card-content {
  display: flex;
  align-items: center;
}

.card-icon {
  width: 50rpx;
  height: 50rpx;
  margin-right: 20rpx;
}

.card-title {
  font-size: 30rpx;
  color: #e0e0e0;
}

.card-arrow {
  font-size: 36rpx;
  color: #8a8a8a;
} 