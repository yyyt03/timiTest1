/* 整体容器 */
.container {
  background: linear-gradient(180deg, #f8fafc 0%, #e2e8f0 100%);
  min-height: 100vh;
  padding: 0;
  box-sizing: border-box;
}

/* 内容区域 */
.content-section {
  padding: 20rpx 30rpx 40rpx;
  box-sizing: border-box;
}

/* 用户信息卡片 */
.user-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  position: relative;
  overflow: hidden;
}

.user-card::before {
  display: none;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar-container {
  margin-right: 20rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(102, 126, 234, 0.2);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.avatar-placeholder {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  border: 3rpx solid rgba(102, 126, 234, 0.2);
}

.user-details {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 6rpx;
}

.user-status {
  font-size: 24rpx;
  color: #64748b;
  font-weight: 400;
}

.login-btn {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border: none;
  border-radius: 40rpx;
  transition: all 0.3s ease;
}

.login-btn:active {
  transform: scale(0.95);
}

.login-text {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 500;
}

/* 功能网格 */
.function-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.function-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.function-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, #667eea, #764ba2);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.function-card:active {
  transform: translateY(2rpx) scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
}

.function-card:active::before {
  opacity: 1;
}

.card-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
  background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.my-plan-icon {
  background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
}

.favorite-icon {
  background: linear-gradient(135deg, #fecaca 0%, #fca5a5 100%);
}

.create-icon {
  background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
}

.card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 24rpx;
  color: #64748b;
  font-weight: 400;
}

.card-arrow {
  font-size: 32rpx;
  color: #94a3b8;
  font-weight: 300;
  transition: all 0.3s ease;
}

.function-card:active .card-arrow {
  transform: translateX(4rpx);
  color: #667eea;
}

/* 占位卡片样式 */
.placeholder-card {
  background: transparent;
  box-shadow: none;
  border: none;
}

.placeholder-card::before {
  display: none;
}

.placeholder-content {
  width: 100%;
  height: 100%;
}

/* 联系信息样式 */
.contact-info {
  text-align: center;
  padding: 40rpx 30rpx;
  margin-top: 20rpx;
}

.contact-text {
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 400;
  opacity: 0.8;
} 